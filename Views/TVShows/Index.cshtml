@model IEnumerable<Movie>
@{
    ViewData["Title"] = "TV Shows - FILMIX";
}

<section class="hero hero--tv">
    <div class="hero__bg" style="background: linear-gradient(to right, rgba(0,0,0,0.8) 0%, transparent 60%), url('/images/auth/ap1.jpg') center/cover;"></div>
    <div class="hero__inner" style="align-items: flex-start; text-align: left; padding-left: 5%;">
        <div class="hero__content" style="max-width: 600px; margin-left: 0;">
            <div class="hero__badge">TV SERIES</div>
            <h1 class="hero__title" style="font-size: 5rem;">STRANGER<br><span class="red">THINGS</span></h1>
            <p class="hero__sub" style="margin-left: 0;">
                Khi một cậu bé mất tích, một thị trấn nhỏ phát hiện ra một bí ẩn liên quan đến các thí nghiệm bí mật, các lực lượng siêu nhiên đáng sợ và một cô bé kỳ lạ.
            </p>
            <div class="hero__actions" style="justify-content: flex-start;">
                <button class="btn btn-red">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
                    Phát
                </button>
                <button class="btn btn-ghost" id="heroSaveBtn" onclick="toggleHeroWatchlist(1, 'Breaking Bad', '/images/movies/1.jpg', this)">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M13 7h-2v4H7v2h4v4h2v-4h4v-2h-4V7zm-1-5C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z" /></svg>
                    <span id="heroSaveBtnText">Danh sách của tôi</span>
                </button>
            </div>
        </div>
    </div>
</section>

<div class="trending" style="padding-top: 20px;">
    <div class="trending__header">
        <h2 class="trending__title">TV Shows Phổ Biến</h2>
    </div>
    <div class="slider-row">
        <div class="slider-track" id="tvTrack1">
            @foreach (var movie in Model)
            {
                <a asp-controller="Product" asp-action="Detail" asp-route-id="@movie.Id" class="t-card" style="display: block; text-decoration: none; color: inherit;">
                    <img class="t-card__img" src="@movie.ImageUrl" alt="@movie.Title" loading="lazy" />
                    <div class="t-card__play">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="white"><path d="M8 5v14l11-7z" /></svg>
                    </div>
                    <div class="t-card__info">
                        <div class="t-card__name">@movie.Title</div>
                        <div class="t-card__meta"><span class="t-card__genre">@movie.Genre</span>@movie.Year</div>
                    </div>
                </a>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        /* Hero watchlist toggle */
        function toggleHeroWatchlist(id, title, img, btn) {
            const span = btn.querySelector('#heroSaveBtnText');
            const movieId = id.toString();
            let watchlist = JSON.parse(localStorage.getItem('filmix_watchlist') || '[]').map(x => x.toString());

            if (watchlist.includes(movieId)) {
                watchlist = watchlist.filter(x => x !== movieId);
                localStorage.setItem('filmix_watchlist', JSON.stringify(watchlist));
                btn.style.background = 'rgba(255,255,255,0.1)';
                btn.style.borderColor = 'rgba(255,255,255,0.18)';
                if (span) span.textContent = 'Danh sách của tôi';
                showHeroToast('Đã xóa khỏi danh sách');
            } else {
                watchlist.push(movieId);
                localStorage.setItem('filmix_watchlist', JSON.stringify(watchlist));
                btn.style.background = 'rgba(70,211,105,0.2)';
                btn.style.borderColor = '#46d369';
                if (span) span.textContent = '✓ Đã Lưu';
                showHeroToast('Đã thêm vào danh sách của bạn');
            }
        }

        function showHeroToast(msg) {
            const t = document.createElement('div');
            t.style.cssText = 'position:fixed;bottom:24px;right:24px;z-index:99999;background:#2f2f2f;color:#fff;padding:12px 24px;border-radius:6px;font-weight:600;font-size:0.9rem;border-left:4px solid #46d369;box-shadow:0 5px 15px rgba(0,0,0,0.4);transition:opacity 0.3s;';
            t.textContent = msg;
            document.body.appendChild(t);
            setTimeout(() => { t.style.opacity = '0'; setTimeout(() => t.remove(), 300); }, 2500);
        }

        // Init state of hero save button on page load
        document.addEventListener('DOMContentLoaded', () => {
            const btn = document.getElementById('heroSaveBtn');
            const span = document.getElementById('heroSaveBtnText');
            if (btn) {
                const wl = JSON.parse(localStorage.getItem('filmix_watchlist') || '[]').map(x => x.toString());
                if (wl.includes('1')) {
                    btn.style.background = 'rgba(70,211,105,0.2)';
                    btn.style.borderColor = '#46d369';
                    if (span) span.textContent = '✓ Đã Lưu';
                }
            }
        });

        /* Navbar effect */
        const nav = document.getElementById('nav');
        window.addEventListener('scroll', () => {
            if (window.scrollY > 50) nav.classList.add('scrolled');
            else nav.classList.remove('scrolled');
        });
    </script>
}
