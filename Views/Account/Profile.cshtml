@model untitled1.Models.Entities.ApplicationUser
@{
    ViewData["Title"] = "Trang Cá Nhân";
    var activeSub = ViewBag.ActiveSubscription as untitled1.Models.Entities.UserSubscription;
    var orders = ViewBag.Orders as IEnumerable<untitled1.Models.Entities.Order> ?? new List<untitled1.Models.Entities.Order>();
    var isPremium = Model.PremiumEndDate.HasValue && Model.PremiumEndDate.Value > DateTime.Now;
}

<div class="sub-page" style="padding-top: 100px; min-height: 80vh; max-width: 1000px; margin: 0 auto; padding-left: 20px; padding-right: 20px;">
    
    <div style="display: grid; grid-template-columns: 300px 1fr; gap: 40px;" class="profile-grid-resp">
        
        <!-- Left Column: User details & Premium card -->
        <div style="display: flex; flex-direction: column; gap: 20px;">
            <!-- User card -->
            <div style="background: rgba(255, 255, 255, 0.03); border-radius: 16px; padding: 30px; border: 1px solid rgba(255, 255, 255, 0.08); text-align: center;">
                <div style="width: 90px; height: 90px; background: #e50914; color: #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2.5rem; font-weight: 800; margin: 0 auto 20px;">
                    @(Model.FullName.Length > 0 ? Model.FullName.Substring(0, 1).ToUpper() : Model.Email?.Substring(0, 1).ToUpper() ?? "U")
                </div>
                <h3 style="color: #fff; font-size: 1.25rem; font-weight: 700; margin-bottom: 5px;">@Model.FullName</h3>
                <p style="color: #aaa; font-size: 0.9rem; word-break: break-all; margin-bottom: 20px;">@Model.Email</p>
                
                @if (isPremium && activeSub != null)
                {
                    <div style="background: linear-gradient(135deg, @activeSub.Plan.AccentColor, #111); border-radius: 12px; padding: 20px; border: 1px solid @activeSub.Plan.AccentColor; text-align: left; position: relative;">
                        <span style="position: absolute; top: 10px; right: 10px; font-size: 1.2rem;">👑</span>
                        <div style="color: #fff; font-size: 0.8rem; text-transform: uppercase; font-weight: 700; letter-spacing: 1px; opacity: 0.8;">Premium Active</div>
                        <div style="color: #fff; font-size: 1.3rem; font-weight: 800; margin-top: 5px;">@activeSub.Plan.Name</div>
                        <div style="color: #ccc; font-size: 0.85rem; margin-top: 10px;">Độ phân giải: @activeSub.Plan.Resolution</div>
                        <div style="height: 1px; background: rgba(255,255,255,0.15); margin: 12px 0;"></div>
                        <div style="color: #aaa; font-size: 0.75rem;">Bắt đầu: @Model.PremiumStartDate?.ToString("dd/MM/yyyy")</div>
                        <div style="color: #aaa; font-size: 0.75rem;">Hết hạn: @Model.PremiumEndDate?.ToString("dd/MM/yyyy")</div>
                    </div>
                }
                else
                {
                    <div style="background: rgba(255, 255, 255, 0.05); border-radius: 12px; padding: 20px; border: 1px solid rgba(255, 255, 255, 0.05); text-align: left;">
                        <div style="color: #aaa; font-size: 0.8rem; text-transform: uppercase; font-weight: 700;">Gói Hiện Tại</div>
                        <div style="color: #fff; font-size: 1.1rem; font-weight: 700; margin-top: 5px;">Tài Khoản Thường</div>
                        <p style="color: #888; font-size: 0.8rem; margin: 10px 0 15px;">Nâng cấp lên Premium để mở khóa kho phim 4K không quảng cáo.</p>
                        <a asp-controller="Subscription" asp-action="Plans" class="plan-cta" style="display: block; text-align: center; text-decoration: none; padding: 8px 12px; font-size: 0.85rem;">Nâng Cấp Ngay</a>
                    </div>
                }
            </div>
        </div>

        <!-- Right Column: Order History -->
        <div style="background: rgba(255, 255, 255, 0.03); border-radius: 16px; padding: 30px; border: 1px solid rgba(255, 255, 255, 0.08);">
            <h2 style="color: #fff; font-size: 1.5rem; font-weight: 700; margin-bottom: 25px; border-bottom: 1px solid rgba(255, 255, 255, 0.1); padding-bottom: 15px;">Lịch Sử Đơn Hàng</h2>
            
            @if (!orders.Any())
            {
                <p style="color: #aaa; font-size: 0.95rem; text-align: center; padding: 40px 0;">Bạn chưa có đơn hàng nào.</p>
            }
            else
            {
                <div style="display: flex; flex-direction: column; gap: 15px;">
                    @foreach (var order in orders)
                    {
                        var statusColor = order.Status switch
                        {
                            untitled1.Models.Entities.OrderStatus.Paid => "#22c55e",
                            untitled1.Models.Entities.OrderStatus.Completed => "#22c55e",
                            untitled1.Models.Entities.OrderStatus.Pending => "#f59e0b",
                            untitled1.Models.Entities.OrderStatus.Processing => "#3b82f6",
                            untitled1.Models.Entities.OrderStatus.Shipping => "#a855f7",
                            untitled1.Models.Entities.OrderStatus.Cancelled => "#ef4444",
                            _ => "#888"
                        };

                        var statusText = order.Status switch
                        {
                            untitled1.Models.Entities.OrderStatus.Paid => "Đã thanh toán",
                            untitled1.Models.Entities.OrderStatus.Completed => "Hoàn thành",
                            untitled1.Models.Entities.OrderStatus.Pending => "Chờ duyệt / Thanh toán",
                            untitled1.Models.Entities.OrderStatus.Processing => "Đang xử lý",
                            untitled1.Models.Entities.OrderStatus.Shipping => "Đang chuyển hàng",
                            untitled1.Models.Entities.OrderStatus.Cancelled => "Đã hủy",
                            _ => order.Status.ToString()
                        };

                        <div style="background: rgba(0, 0, 0, 0.2); border-radius: 10px; padding: 20px; border: 1px solid rgba(255, 255, 255, 0.05); display: flex; justify-content: space-between; align-items: center;" class="profile-order-item">
                            <div>
                                <div style="font-weight: 700; color: #fff;">Đơn hàng #FX-ORD-@order.Id</div>
                                <div style="font-size: 0.8rem; color: #aaa; margin-top: 4px;">Đặt ngày: @order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                                <div style="font-size: 0.85rem; color: #ccc; margin-top: 8px;">
                                    @string.Join(", ", order.OrderItems.Select(oi => $"Gói {oi.Plan.Name} (x{oi.Quantity})"))
                                </div>
                            </div>
                            <div style="text-align: right;">
                                <div style="font-size: 1.15rem; font-weight: 800; color: #e50914; margin-bottom: 5px;">@order.TotalAmount.ToString("N0") ₫</div>
                                <span style="color: @statusColor; font-size: 0.75rem; font-weight: 700; background: @(statusColor)20; border: 1px solid @(statusColor)30; padding: 2px 10px; border-radius: 20px;">
                                    @statusText
                                </span>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
        
    </div>

</div>

<style>
    @@media (max-width: 768px) {
        .profile-grid-resp {
            grid-template-columns: 1fr !important;
        }
        .profile-order-item {
            flex-direction: column !important;
            align-items: flex-start !important;
            gap: 15px;
        }
        .profile-order-item div {
            text-align: left !important;
        }
    }
</style>
