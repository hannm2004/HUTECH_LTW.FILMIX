@{
    Layout = null;
    ViewData["Title"] = "Truy cập bị từ chối — FILMIX";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
    <style>
        /* ── Page reset ── */
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            background: #0a0a0a;
            color: #e5e5e5;
            font-family: 'Inter', 'Segoe UI', system-ui, sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            position: relative;
        }

        /* ── Animated background ── */
        .bg-grid {
            position: fixed;
            inset: 0;
            background-image:
                linear-gradient(rgba(229,9,20,0.04) 1px, transparent 1px),
                linear-gradient(90deg, rgba(229,9,20,0.04) 1px, transparent 1px);
            background-size: 60px 60px;
            animation: gridPan 20s linear infinite;
            z-index: 0;
        }

        @@keyframes gridPan {
            0%   { background-position: 0 0; }
            100% { background-position: 60px 60px; }
        }

        .bg-glow {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 600px;
            height: 600px;
            background: radial-gradient(circle, rgba(229,9,20,0.12) 0%, transparent 70%);
            z-index: 0;
            animation: pulseGlow 4s ease-in-out infinite alternate;
        }

        @@keyframes pulseGlow {
            from { transform: translate(-50%, -50%) scale(1);   opacity: 0.7; }
            to   { transform: translate(-50%, -50%) scale(1.15); opacity: 1;   }
        }

        /* ── Card ── */
        .card {
            position: relative;
            z-index: 1;
            background: rgba(18, 18, 18, 0.85);
            border: 1px solid rgba(229, 9, 20, 0.25);
            border-radius: 20px;
            padding: 56px 48px 48px;
            max-width: 500px;
            width: calc(100% - 32px);
            text-align: center;
            backdrop-filter: blur(20px);
            box-shadow:
                0 0 0 1px rgba(229,9,20,0.1),
                0 24px 64px rgba(0,0,0,0.7),
                inset 0 1px 0 rgba(255,255,255,0.05);
            animation: slideUp 0.5s cubic-bezier(0.22,1,0.36,1) both;
        }

        @@keyframes slideUp {
            from { opacity: 0; transform: translateY(32px) scale(0.97); }
            to   { opacity: 1; transform: translateY(0)   scale(1);    }
        }

        /* ── Shield icon ── */
        .icon-wrap {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 88px;
            height: 88px;
            border-radius: 50%;
            background: rgba(229,9,20,0.12);
            border: 1px solid rgba(229,9,20,0.3);
            margin-bottom: 28px;
            animation: iconBounce 0.6s 0.2s cubic-bezier(0.22,1,0.36,1) both;
        }

        @@keyframes iconBounce {
            from { opacity: 0; transform: scale(0.6); }
            to   { opacity: 1; transform: scale(1);   }
        }

        .icon-wrap svg {
            color: #e50914;
            filter: drop-shadow(0 0 12px rgba(229,9,20,0.5));
        }

        /* ── Typography ── */
        .error-code {
            font-size: 0.72rem;
            font-weight: 700;
            letter-spacing: 4px;
            text-transform: uppercase;
            color: #e50914;
            margin-bottom: 12px;
            opacity: 0;
            animation: fadeIn 0.4s 0.35s ease forwards;
        }

        .title {
            font-size: 2rem;
            font-weight: 800;
            letter-spacing: -0.5px;
            color: #ffffff;
            margin-bottom: 14px;
            opacity: 0;
            animation: fadeIn 0.4s 0.45s ease forwards;
        }

        .description {
            font-size: 0.95rem;
            line-height: 1.65;
            color: rgba(229,229,229,0.6);
            margin-bottom: 36px;
            opacity: 0;
            animation: fadeIn 0.4s 0.55s ease forwards;
        }

        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(8px); }
            to   { opacity: 1; transform: translateY(0);   }
        }

        /* ── Divider ── */
        .divider {
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(229,9,20,0.3), transparent);
            margin-bottom: 36px;
            opacity: 0;
            animation: fadeIn 0.4s 0.6s ease forwards;
        }

        /* ── Buttons ── */
        .btn-group {
            display: flex;
            gap: 12px;
            justify-content: center;
            flex-wrap: wrap;
            opacity: 0;
            animation: fadeIn 0.4s 0.7s ease forwards;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 13px 28px;
            border-radius: 10px;
            font-size: 0.9rem;
            font-weight: 600;
            letter-spacing: 0.3px;
            text-decoration: none;
            transition: transform 0.2s, box-shadow 0.2s, background 0.2s;
            cursor: pointer;
            border: none;
        }

        .btn:active { transform: scale(0.97); }

        .btn-primary {
            background: #e50914;
            color: #ffffff;
            box-shadow: 0 4px 20px rgba(229,9,20,0.35);
        }

        .btn-primary:hover {
            background: #ff1a24;
            box-shadow: 0 6px 28px rgba(229,9,20,0.55);
            transform: translateY(-2px);
        }

        .btn-ghost {
            background: rgba(255,255,255,0.05);
            color: rgba(229,229,229,0.75);
            border: 1px solid rgba(255,255,255,0.1);
        }

        .btn-ghost:hover {
            background: rgba(255,255,255,0.1);
            color: #ffffff;
            transform: translateY(-2px);
        }

        /* ── FILMIX brand (top-left) ── */
        .brand {
            position: fixed;
            top: 24px;
            left: 28px;
            z-index: 10;
            font-size: 1.35rem;
            font-weight: 900;
            letter-spacing: -1px;
            color: #ffffff;
            text-decoration: none;
        }

        .brand span { color: #e50914; }

        /* ── Responsive ── */
        @@media (max-width: 480px) {
            .card { padding: 40px 28px 36px; }
            .title { font-size: 1.6rem; }
            .btn-group { flex-direction: column; }
            .btn { justify-content: center; }
        }
    </style>
</head>
<body>
    <!-- Background layers -->
    <div class="bg-grid" aria-hidden="true"></div>
    <div class="bg-glow" aria-hidden="true"></div>

    <!-- FILMIX brand link -->
    <a href="/" class="brand">FILM<span>IX</span></a>

    <!-- Access Denied card -->
    <main class="card" role="main">

        <!-- Shield icon -->
        <div class="icon-wrap" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24"
                 fill="none" stroke="currentColor" stroke-width="1.8"
                 stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                <line x1="12" y1="8" x2="12" y2="12"/>
                <line x1="12" y1="16" x2="12.01" y2="16"/>
            </svg>
        </div>

        <p class="error-code">Lỗi 403 — Từ chối truy cập</p>

        <h1 class="title">Truy Cập Bị Từ Chối</h1>

        <p class="description">
            Bạn không có quyền truy cập trang này.<br />
            Trang này yêu cầu quyền <strong>Admin</strong> hoặc vai trò cao hơn.<br />
            Vui lòng liên hệ quản trị viên nếu bạn cho rằng đây là lỗi.
        </p>

        <div class="divider" aria-hidden="true"></div>

        <div class="btn-group">
            <a href="/" class="btn btn-primary" id="btn-home">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                     fill="currentColor">
                    <path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/>
                </svg>
                Về Trang Chủ
            </a>
            <a href="javascript:history.back()" class="btn btn-ghost" id="btn-back">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                     fill="currentColor">
                    <path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/>
                </svg>
                Quay Lại
            </a>
        </div>

    </main>
</body>
</html>
