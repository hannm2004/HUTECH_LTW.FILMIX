@model untitled1.Models.Entities.Order
@{
    ViewData["Title"] = "Thanh Toán Thành Công";
}

<div class="sub-page" style="padding-top: 100px; min-height: 80vh; max-width: 650px; margin: 0 auto; padding-left: 20px; padding-right: 20px; text-align: center; position: relative; overflow: hidden;">
    <!-- Canvas for Confetti -->
    <canvas id="confetti-canvas" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 1;"></canvas>

    <div style="background: rgba(255, 255, 255, 0.03); border-radius: 16px; padding: 40px; border: 1px solid rgba(255, 255, 255, 0.08); position: relative; z-index: 2;">
        
        <!-- Animated Checkmark -->
        <div class="success-icon-wrap" style="margin-bottom: 25px; display: inline-flex; justify-content: center; align-items: center; width: 80px; height: 80px; background: rgba(34, 197, 94, 0.1); border-radius: 50%; border: 2px solid #22c55e;">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
        </div>

        <h1 style="color: #fff; font-size: 2.2rem; font-weight: 800; margin-bottom: 10px;">Thanh Toán Hoàn Tất!</h1>
        <p style="color: #ccc; margin-bottom: 30px;">Cảm ơn bạn. Giao dịch của bạn đã được thực hiện thành công.</p>

        <!-- Order Summary Details -->
        <div style="background: rgba(0, 0, 0, 0.3); border-radius: 12px; padding: 25px; border: 1px solid rgba(255, 255, 255, 0.05); text-align: left; margin-bottom: 35px; display: flex; flex-direction: column; gap: 12px; font-size: 0.95rem;">
            <div style="display: flex; justify-content: space-between;">
                <span style="color: #aaa;">Mã đơn hàng:</span>
                <strong style="color: #fff;">#FX-ORD-@Model.Id</strong>
            </div>
            <div style="display: flex; justify-content: space-between;">
                <span style="color: #aaa;">Họ tên:</span>
                <span style="color: #fff; font-weight: 600;">@Model.FullName</span>
            </div>
            <div style="display: flex; justify-content: space-between;">
                <span style="color: #aaa;">Phương thức thanh toán:</span>
                <span style="color: #fff; font-weight: 600;">@Model.PaymentMethod</span>
            </div>
            <div style="display: flex; justify-content: space-between;">
                <span style="color: #aaa;">Trạng thái đơn hàng:</span>
                @if (Model.Status == untitled1.Models.Entities.OrderStatus.Paid)
                {
                    <span style="color: #22c55e; font-weight: 700; background: rgba(34, 197, 94, 0.15); padding: 2px 10px; border-radius: 20px; font-size: 0.85rem;">Đã thanh toán</span>
                }
                else
                {
                    <span style="color: #f59e0b; font-weight: 700; background: rgba(245, 158, 11, 0.15); padding: 2px 10px; border-radius: 20px; font-size: 0.85rem;">Chờ thanh toán / Duyệt</span>
                }
            </div>
            
            <div style="height: 1px; background: rgba(255, 255, 255, 0.1); margin: 5px 0;"></div>

            <div style="display: flex; justify-content: space-between; font-size: 1.1rem; font-weight: 700;">
                <span style="color: #fff;">Tổng cộng:</span>
                <span style="color: #e50914;">@Model.TotalAmount.ToString("N0") ₫</span>
            </div>
        </div>

        @if (Model.Status == untitled1.Models.Entities.OrderStatus.Paid)
        {
            <div style="background: rgba(34, 197, 94, 0.1); border: 1px solid rgba(34, 197, 94, 0.2); border-radius: 8px; padding: 15px; margin-bottom: 35px; color: #fff; font-size: 0.9rem; line-height: 1.5;">
                🎉 <strong>Gói Premium của bạn đã được kích hoạt thành công!</strong><br />
                Bây giờ bạn có thể trải nghiệm toàn bộ kho phim HD/4K không giới hạn và không quảng cáo trên FILMIX.
            </div>
        }
        else
        {
            <div style="background: rgba(245, 158, 11, 0.1); border: 1px solid rgba(245, 158, 11, 0.2); border-radius: 8px; padding: 15px; margin-bottom: 35px; color: #fff; font-size: 0.9rem; line-height: 1.5;">
                ⚠️ <strong>Đơn hàng đang chờ xử lý.</strong><br />
                Ngay khi nhận được thanh toán, gói Premium của bạn sẽ được kích hoạt tự động.
            </div>
        }

        <div style="display: flex; gap: 15px; justify-content: center;">
            <a asp-controller="Home" asp-action="Index" class="plan-cta" style="flex: 1; text-decoration: none; text-align: center; box-sizing: border-box;">
                Bắt Đầu Xem Phim
            </a>
            <a asp-controller="Order" asp-action="History" style="flex: 1; display: flex; align-items: center; justify-content: center; background: rgba(255, 255, 255, 0.1); color: #fff; border: 1px solid rgba(255,255,255,0.2); text-decoration: none; border-radius: 6px; font-weight: 700; transition: all 0.2s;" onmouseover="this.style.background='rgba(255,255,255,0.15)'" onmouseout="this.style.background='rgba(255,255,255,0.1)'">
                Lịch Sử Đơn Hàng
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Confetti effect code
        (function() {
            const canvas = document.getElementById("confetti-canvas");
            const ctx = canvas.getContext("2d");
            
            let width = canvas.width = canvas.offsetWidth;
            let height = canvas.height = canvas.offsetHeight;
            
            window.addEventListener('resize', () => {
                width = canvas.width = canvas.offsetWidth;
                height = canvas.height = canvas.offsetHeight;
            });

            const colors = ['#e50914', '#ffffff', '#22c55e', '#3b82f6', '#eab308'];
            const particles = [];

            for (let i = 0; i < 75; i++) {
                particles.push({
                    x: Math.random() * width,
                    y: Math.random() * -height,
                    r: Math.random() * 6 + 4,
                    d: Math.random() * height,
                    color: colors[Math.floor(Math.random() * colors.length)],
                    tilt: Math.random() * 10 - 5,
                    tiltAngleIncremental: Math.random() * 0.07 + 0.02,
                    tiltAngle: 0
                });
            }

            function draw() {
                ctx.clearRect(0, 0, width, height);
                particles.forEach((p, idx) => {
                    p.tiltAngle += p.tiltAngleIncremental;
                    p.y += (Math.cos(p.d) + 3 + p.r / 2) / 2;
                    p.x += Math.sin(p.tiltAngle);
                    p.tilt = Math.sin(p.tiltAngle - (idx / 3)) * 15;

                    ctx.beginPath();
                    ctx.lineWidth = p.r;
                    ctx.strokeStyle = p.color;
                    ctx.moveTo(p.x + p.tilt + p.r / 2, p.y);
                    ctx.lineTo(p.x + p.tilt, p.y + p.tilt + p.r / 2);
                    ctx.stroke();
                });

                update();
                requestAnimationFrame(draw);
            }

            function update() {
                particles.forEach((p) => {
                    if (p.y > height) {
                        p.x = Math.random() * width;
                        p.y = -20;
                    }
                });
            }

            draw();
        })();
    </script>
}
