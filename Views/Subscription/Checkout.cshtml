@model untitled1.Models.Entities.SubscriptionPlan
@{
    ViewData["Title"] = "Thanh Toán — " + Model.Name;
    var planIcon = Model.Id == 1 ? "📺" : Model.Id == 2 ? "🎬" : "💎";
    var activeSub = ViewBag.ActiveSubscription as untitled1.Models.Entities.UserSubscription;
}

<div class="sub-page">
    <div class="checkout-wrap">
        <!-- Breadcrumb -->
        <div class="checkout-breadcrumb">
            <a href="@Url.Action("Plans","Subscription")" style="color:#666;text-decoration:none">Chọn Gói</a>
            <span class="sep">›</span>
            <span class="active">Thanh Toán</span>
            <span class="sep">›</span>
            <span>Hoàn Thành</span>
        </div>

        <div class="checkout-layout">
            <!-- LEFT: Payment form -->
            <div>
                <div class="payment-methods-label">Phương Thức Thanh Toán</div>
                <div class="payment-tabs">
                    <button class="pay-tab active" onclick="switchTab('card',this)" id="tab-card">
                        💳 Thẻ Ngân Hàng
                    </button>
                    <button class="pay-tab" onclick="switchTab('momo',this)" id="tab-momo">
                        🟣 MoMo
                    </button>
                    <button class="pay-tab" onclick="switchTab('zalopay',this)" id="tab-zalopay">
                        🔵 ZaloPay
                    </button>
                    <button class="pay-tab" onclick="switchTab('banking',this)" id="tab-banking">
                        🏦 Chuyển Khoản
                    </button>
                </div>

                <!-- CREDIT CARD PANEL -->
                <div class="checkout-panel active" id="panel-card">
                    <!-- Card visual -->
                    <div class="card-scene">
                        <div class="card-3d" id="card3d">
                            <div class="card-face front">
                                <div class="card-chip"></div>
                                <div class="card-number-display" id="cardNumDisplay">•••• •••• •••• ••••</div>
                                <div class="card-bottom">
                                    <div>
                                        <div class="card-holder-label">Chủ Thẻ</div>
                                        <div class="card-holder-display" id="cardHolderDisplay">TÊN CHỦ THẺ</div>
                                    </div>
                                    <div>
                                        <div class="card-expiry-label">Hết Hạn</div>
                                        <div class="card-expiry-display" id="cardExpiryDisplay">MM/YY</div>
                                    </div>
                                    <div class="card-brand" id="cardBrand">💳</div>
                                </div>
                            </div>
                            <div class="card-face back">
                                <div class="card-back-stripe"></div>
                                <div class="card-back-cvv-wrap">
                                    <div class="card-back-cvv-label">CVV</div>
                                    <div class="card-back-cvv-box" id="cvvDisplay">•••</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Card form -->
                    <div class="form-group">
                        <label>Số Thẻ</label>
                        <input type="text" class="checkout-input" id="cardNumber" maxlength="19"
                               placeholder="1234 5678 9012 3456"
                               oninput="formatCard(this)" />
                    </div>
                    <div class="form-group">
                        <label>Tên Chủ Thẻ</label>
                        <input type="text" class="checkout-input" id="cardHolder"
                               placeholder="NGUYEN VAN A"
                               oninput="document.getElementById('cardHolderDisplay').textContent = this.value.toUpperCase() || 'TÊN CHỦ THẺ'" />
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>Ngày Hết Hạn</label>
                            <input type="text" class="checkout-input" id="cardExpiry" maxlength="5"
                                   placeholder="MM/YY"
                                   oninput="formatExpiry(this)" />
                        </div>
                        <div class="form-group">
                            <label>CVV</label>
                            <input type="password" class="checkout-input" id="cardCvv" maxlength="3"
                                   placeholder="•••"
                                   onfocus="document.getElementById('card3d').classList.add('flipped')"
                                   onblur="document.getElementById('card3d').classList.remove('flipped')"
                                   oninput="document.getElementById('cvvDisplay').textContent = this.value || '•••'" />
                        </div>
                    </div>
                </div>

                <!-- MOMO PANEL -->
                <div class="checkout-panel" id="panel-momo">
                    <div class="ewallet-panel">
                        <div class="ewallet-qr">📱</div>
                        <p class="ewallet-info">Mở app <strong>MoMo</strong> → Quét mã QR để thanh toán<br>
                        Số tiền: <strong>@Model.Price.ToString("N0")₫</strong></p>
                        <div class="ewallet-or">─── hoặc nhập số điện thoại ───</div>
                        <div class="form-group" style="max-width:300px;margin:0 auto">
                            <label>Số Điện Thoại MoMo</label>
                            <input type="tel" class="checkout-input" placeholder="09xxxxxxxx" maxlength="10" />
                        </div>
                    </div>
                </div>

                <!-- ZALOPAY PANEL -->
                <div class="checkout-panel" id="panel-zalopay">
                    <div class="ewallet-panel">
                        <div class="ewallet-qr">⚡</div>
                        <p class="ewallet-info">Mở app <strong>ZaloPay</strong> → Quét mã QR để thanh toán<br>
                        Số tiền: <strong>@Model.Price.ToString("N0")₫</strong></p>
                        <div class="ewallet-or">─── hoặc nhập số điện thoại ───</div>
                        <div class="form-group" style="max-width:300px;margin:0 auto">
                            <label>Số Điện Thoại ZaloPay</label>
                            <input type="tel" class="checkout-input" placeholder="09xxxxxxxx" maxlength="10" />
                        </div>
                    </div>
                </div>

                <!-- BANK TRANSFER PANEL -->
                <div class="checkout-panel" id="panel-banking">
                    <div class="bank-card">
                        <div class="bank-row">
                            <span class="key">Ngân Hàng</span>
                            <span class="val">Vietcombank (VCB)</span>
                        </div>
                        <div class="bank-row">
                            <span class="key">Số Tài Khoản</span>
                            <span class="val">
                                1234 5678 9012
                                <button class="copy-btn" onclick="copyText('1234567890123')">Sao chép</button>
                            </span>
                        </div>
                        <div class="bank-row">
                            <span class="key">Chủ Tài Khoản</span>
                            <span class="val">CONG TY TNHH FILMIX</span>
                        </div>
                        <div class="bank-row">
                            <span class="key">Số Tiền</span>
                            <span class="val accent">@Model.Price.ToString("N0")₫</span>
                        </div>
                        <div class="bank-row">
                            <span class="key">Nội Dung CK</span>
                            <span class="val">
                                FILMIX @Model.Name @User.Identity?.Name
                                <button class="copy-btn" onclick="copyText('FILMIX @Model.Name @User.Identity?.Name')">Sao chép</button>
                            </span>
                        </div>
                    </div>
                    <p style="color:#777;font-size:0.82rem;margin-top:14px;text-align:center">
                        ⚠️ Vui lòng chuyển khoản đúng nội dung. Tài khoản sẽ được kích hoạt trong vòng 15 phút.
                    </p>
                </div>
            </div>

            <!-- RIGHT: Order summary -->
            <div class="checkout-summary" style="--plan-accent: @Model.AccentColor">
                <div class="summary-title">📋 Tóm Tắt Đơn Hàng</div>

                <div class="summary-plan">
                    <div class="summary-plan__icon">@planIcon</div>
                    <div>
                        <div class="summary-plan__name">Gói @Model.Name</div>
                        <div class="summary-plan__res">@Model.Resolution</div>
                    </div>
                </div>

                <div class="summary-row"><span>Gói đăng ký</span><span>Gói @Model.Name</span></div>
                <div class="summary-row"><span>Thời hạn</span><span>1 tháng</span></div>
                <div class="summary-row"><span>Màn hình</span><span>@Model.MaxScreens màn hình</span></div>
                @if (activeSub != null)
                {
                    <div class="summary-row" style="color:#f59e0b">
                        <span>⚠ Gói hiện tại</span><span>@activeSub.Plan?.Name</span>
                    </div>
                    <div class="summary-row" style="color:#888;font-size:0.8rem">
                        <span colspan="2">Sẽ được thay thế ngay</span>
                    </div>
                }
                <div class="summary-divider"></div>
                <div class="summary-row total">
                    <span>Tổng Cộng</span>
                    <span>@Model.Price.ToString("N0")₫</span>
                </div>

                <!-- Hidden form for POST -->
                <form method="post" action="@Url.Action("ProcessPayment","Subscription")" id="payForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="planId" value="@Model.Id" />
                    <input type="hidden" name="paymentMethod" id="payMethodInput" value="credit_card" />
                    <button type="button" class="pay-btn" onclick="submitPayment()">
                        🔒 Xác Nhận Thanh Toán
                    </button>
                </form>

                <div class="security-badges">
                    <span class="sec-badge"><span class="icon">🔒</span> SSL Bảo Mật</span>
                    <span class="sec-badge"><span class="icon">🛡️</span> An Toàn 100%</span>
                    <span class="sec-badge"><span class="icon">↩️</span> Hoàn Tiền 30 Ngày</span>
                </div>
                <a href="@Url.Action("Plans","Subscription")" class="summary-cancel">← Quay lại chọn gói</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
let activeTab = 'card';

function switchTab(tab, btn) {
    activeTab = tab;
    document.querySelectorAll('.checkout-panel').forEach(p => p.classList.remove('active'));
    document.querySelectorAll('.pay-tab').forEach(b => b.classList.remove('active'));
    document.getElementById('panel-' + tab).classList.add('active');
    btn.classList.add('active');
    const methodMap = { card:'credit_card', momo:'momo', zalopay:'zalopay', banking:'banking' };
    document.getElementById('payMethodInput').value = methodMap[tab];
}

function formatCard(el) {
    let v = el.value.replace(/\D/g,'').substring(0,16);
    el.value = v.replace(/(.{4})/g,'$1 ').trim();
    document.getElementById('cardNumDisplay').textContent =
        (v + '................').substring(0,16).replace(/(.{4})/g,'$1 ').trim().replace(/\d/g,'•').replace(/•{4}/g, (m,i) => v.substring(i/5*4, i/5*4+4).padEnd(4,'•'));
    // detect brand
    const brand = document.getElementById('cardBrand');
    if (v.startsWith('4')) brand.textContent = '💳 Visa';
    else if (v.startsWith('5')) brand.textContent = '💳 MC';
    else if (v.startsWith('3')) brand.textContent = '💳 Amex';
    else brand.textContent = '💳';
    // show real digits on display
    const groups = [];
    for(let i=0;i<16;i+=4) groups.push((v.substring(i,i+4)||'').padEnd(4,'•'));
    document.getElementById('cardNumDisplay').textContent = groups.join(' ');
}

function formatExpiry(el) {
    let v = el.value.replace(/\D/g,'').substring(0,4);
    if (v.length >= 3) v = v.substring(0,2)+'/'+v.substring(2);
    el.value = v;
    document.getElementById('cardExpiryDisplay').textContent = v || 'MM/YY';
}

function copyText(t) {
    navigator.clipboard.writeText(t).then(() => {
        const btns = document.querySelectorAll('.copy-btn');
        btns.forEach(b => { if(b.onclick.toString().includes(t.substring(0,6))) { const orig=b.textContent; b.textContent='✓ Đã chép'; setTimeout(()=>b.textContent=orig,1500); } });
    });
}

function submitPayment() {
    if (activeTab === 'card') {
        const num = document.getElementById('cardNumber').value.replace(/\s/g,'');
        const holder = document.getElementById('cardHolder').value;
        const expiry = document.getElementById('cardExpiry').value;
        const cvv = document.getElementById('cardCvv').value;
        if (num.length < 16) { alert('Vui lòng nhập đủ số thẻ!'); return; }
        if (!holder.trim()) { alert('Vui lòng nhập tên chủ thẻ!'); return; }
        if (expiry.length < 5) { alert('Vui lòng nhập ngày hết hạn!'); return; }
        if (cvv.length < 3) { alert('Vui lòng nhập CVV!'); return; }
    }
    const btn = document.querySelector('.pay-btn');
    btn.textContent = '⏳ Đang xử lý...';
    btn.disabled = true;
    setTimeout(() => document.getElementById('payForm').submit(), 1200);
}
</script>
}
