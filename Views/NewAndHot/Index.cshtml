@model IEnumerable<Movie>
@{
    ViewData["Title"] = "Mới & Hot - FILMIX";
}

<style>
    .trending-list {
        padding: 5% 4%;
        background: #000;
        min-height: 100vh;
    }
    .trending-item {
        display: flex;
        gap: 30px;
        margin-bottom: 50px;
        background: rgba(255, 255, 255, 0.05);
        padding: 20px;
        border-radius: 12px;
        transition: transform 0.3s ease, background 0.3s ease;
        position: relative;
        overflow: hidden;
    }
    .trending-item:hover {
        transform: scale(1.02);
        background: rgba(255, 255, 255, 0.1);
    }
    .trending-item__rank {
        font-size: 5rem;
        font-weight: 900;
        color: rgba(255, 255, 255, 0.1);
        position: absolute;
        left: 20px;
        top: 10px;
        line-height: 1;
        pointer-events: none;
    }
    .trending-item__img {
        width: 180px;
        height: 270px;
        object-fit: cover;
        border-radius: 8px;
        box-shadow: 0 10px 20px rgba(0,0,0,0.5);
        flex-shrink: 0;
        z-index: 1;
    }
    .trending-item__content {
        display: flex;
        flex-direction: column;
        justify-content: center;
        z-index: 1;
    }
    .trending-item__badge {
        display: inline-block;
        padding: 4px 12px;
        background: #e50914;
        color: #fff;
        font-size: 0.75rem;
        font-weight: bold;
        border-radius: 4px;
        margin-bottom: 15px;
        width: fit-content;
    }
    .trending-item__title {
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 10px;
    }
    .trending-item__meta {
        font-size: 1rem;
        color: #aaa;
        margin-bottom: 15px;
    }
    .trending-item__desc {
        color: #ccc;
        font-size: 1rem;
        line-height: 1.6;
        max-width: 800px;
        margin-bottom: 20px;
    }
    .trending-item__actions {
        display: flex;
        gap: 15px;
    }

    .hot-hero {
        height: 70vh;
        position: relative;
        display: flex;
        align-items: center;
        padding: 0 5%;
        background: linear-gradient(to bottom, rgba(0,0,0,0.2) 0%, rgba(0,0,0,0.9) 100%), url('/images/hero/hero-bg.jpg') center/cover;
    }
    .hot-hero__title {
        font-size: 4rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 2px;
    }
    .hot-hero__title span {
        color: #e50914;
    }
</style>

<section class="hot-hero">
    <div class="hot-hero__content">
        <h1 class="hot-hero__title"><span data-i18n="page.newHot">Mới &amp; Hot</span></h1>
        <p style="font-size: 1.2rem; max-width: 600px;" data-i18n="page.newHot.sub">Những bộ phim và series truyền hình đang thịnh hành nhất trên FILMIX. Luôn cập nhật những nội dung mới nhất mỗi ngày.</p>
    </div>
</section>

<div class="trending-list">
    @{ int rank = 1; }
    @foreach (var movie in Model)
    {
        <div class="trending-item">
            <div class="trending-item__rank">TOP @rank</div>
            <img class="trending-item__img" src="@movie.ImageUrl" alt="@movie.Title">
            <div class="trending-item__content">
                <div class="trending-item__badge">XEM NHIỀU NHẤT</div>
                <h2 class="trending-item__title">@movie.Title</h2>
                <div class="trending-item__meta">
                    <span>@movie.Year</span> • 
                    <span>@movie.Genre</span> • 
                    <span>@(movie.IsTVSeries ? "TV Series" : "Movie")</span>
                </div>
                <p class="trending-item__desc">@movie.Description</p>
                <div class="trending-item__actions">
                    <button class="btn btn-red" data-i18n="ui.play">Phát ngay</button>
                    <button class="btn btn-ghost" data-i18n="ui.details">Chi tiết</button>
                </div>
            </div>
        </div>
        rank++;
    }
</div>
