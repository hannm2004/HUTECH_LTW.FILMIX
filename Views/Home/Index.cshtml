@using untitled1.Models.Entities
@{
    ViewData["Title"] = "FILMIX — Xem Phim Không Giới Hạn";
    var trending   = ViewBag.Trending   as IEnumerable<Movie> ?? Enumerable.Empty<Movie>();
    var allMovies  = ViewBag.AllMovies  as IEnumerable<Movie> ?? Enumerable.Empty<Movie>();
}

<!-- ══════════════════════════════════════════════════════════
     HERO BANNER VIEW COMPONENT
══════════════════════════════════════════════════════════ -->
@await Component.InvokeAsync("HeroBanner")

<div class="divider"></div>

<!-- ══════════════════════════════════════
     CONTINUE WATCHING (populated by JS from localStorage)
══════════════════════════════════════ -->
<section class="cw-section" id="cwSection" aria-label="Tiếp tục xem">
    <div class="cw-header">
        <h2 class="cw-title">
            <span class="cw-title__icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 14.5v-9l6 4.5-6 4.5z"/>
                </svg>
            </span>
            Tiếp Tục Xem
        </h2>
        <button class="cw-clear-btn" id="cwClearBtn" onclick="clearAllCW()">Xóa Tất Cả</button>
    </div>

    <div class="cw-slider-row slider-row" id="cwSliderRow">
        <div class="cw-slider-track slider-track" id="cwTrack">
            <!-- Populated dynamically by continue-watching.js -->
        </div>
    </div>
</section>

<div class="divider"></div>

<!-- ══════════════════════════════════════
     ĐỀ XUẤT DÀNH CHO BẠN (Netflix-style Slider)
     ══════════════════════════════════════ -->
@{
    var recommendations = ViewBag.Recommendations as IEnumerable<Movie> ?? Enumerable.Empty<Movie>();
}
@if (recommendations.Any())
{
    <section class="rec-section" style="margin-bottom: 40px; padding: 0 4%;">
        <div class="rec-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
            <h2 style="font-size: 1.6rem; font-weight: 800; color: #fff; margin: 0; display: flex; align-items: center; gap: 10px; font-family: 'Outfit', sans-serif;">
                <span style="display: inline-block; width: 4px; height: 24px; background: #e50914; border-radius: 2px;"></span>
                Đề Xuất Dành Cho Bạn
            </h2>
        </div>
        
        <div class="slider-row" style="position: relative;">
            <div class="slider-track" id="recSliderTrack" style="display: flex; gap: 12px; overflow-x: auto; padding-bottom: 15px; scroll-behavior: smooth; scrollbar-width: none;">
                @foreach (var movie in recommendations)
                {
                    <a href="/Product/Detail/@movie.Id"
                       class="product-card"
                       style="flex: 0 0 200px; text-decoration: none; display: block; border-radius: 8px; overflow: hidden; transition: transform 0.3s ease;"
                       onmouseover="this.style.transform='scale(1.06)'; this.style.zIndex='10';"
                       onmouseout="this.style.transform='scale(1)'; this.style.zIndex='1';">
                        <div style="position: relative; aspect-ratio: 2/3; background: #2f2f2f; border-radius: 8px; overflow: hidden;">
                            <img src="@movie.ImageUrl"
                                 alt="@movie.Title"
                                 style="width: 100%; height: 100%; object-fit: cover; display: block;"
                                 onerror="this.src='/images/movies/default.jpg'" />
                            <div style="position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.8) 0%, transparent 60%); opacity: 0; transition: opacity 0.3s ease;"
                                 onmouseover="this.style.opacity='1'"
                                 onmouseout="this.style.opacity='0'">
                                <div style="position: absolute; bottom: 10px; left: 10px; right: 10px;">
                                    <p style="margin: 0; font-size: 0.8rem; font-weight: 700; color: #fff; line-height: 1.3;">@movie.Title</p>
                                    <p style="margin: 3px 0 0; font-size: 0.72rem; color: #ccc;">@movie.Year · @movie.Genre</p>
                                </div>
                            </div>
                            @if (movie.IsTVSeries)
                            {
                                <span style="position: absolute; top: 8px; left: 8px; background: #e50914; color: #fff; font-size: 0.65rem; font-weight: 700; padding: 2px 6px; border-radius: 3px; text-transform: uppercase;">Series</span>
                            }
                        </div>
                        <div style="padding: 8px 4px 0;">
                            <p style="margin: 0; font-size: 0.88rem; font-weight: 700; color: #fff; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@movie.Title</p>
                            <p style="margin: 3px 0 0; font-size: 0.78rem; color: #999;">@movie.Year</p>
                        </div>
                    </a>
                }
            </div>
        </div>
    </section>
    <div class="divider"></div>
}

<!-- ══════════════════════════════════════
     TRENDING (dữ liệu thực từ DB)
══════════════════════════════════════ -->
<section class="trending" id="trending">
    <div class="trending__header">
        <h2 class="trending__title" data-i18n="trending.title">Đang Hot Nhất</h2>
        <div class="trending__meta">
            <span class="trending__badge" data-i18n="trending.badge">🔥 Top 10 Hôm Nay</span>
            <button class="btn-see-all" id="seeAllBtn" onclick="toggleAllMovies()">
                <span data-i18n="trending.seeAll">Xem Tất Cả</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z" />
                </svg>
            </button>
        </div>
    </div>

    <!-- Netflix-Style Slider Row -->
    <div class="slider-row">
        <div class="slider-track" id="trendingTrack">
            @{ int rank = 1; }
            @foreach (var movie in trending)
            {
                <a href="/Product/Detail/@movie.Id" class="t-card" style="display: block; text-decoration: none; color: inherit;">
                    <img class="t-card__img"
                         src="@movie.ImageUrl"
                         onerror="this.onerror=null;this.src='/images/movies/default.jpg'"
                         alt="@movie.Title" loading="lazy" />
                    <span class="t-card__num">@rank</span>
                    <div class="t-card__play"><svg width="18" height="18" viewBox="0 0 24 24" fill="white">
                            <path d="M8 5v14l11-7z" /></svg></div>
                    <div class="t-card__info">
                        <div class="t-card__name">@movie.Title</div>
                        <div class="t-card__meta"><span class="t-card__genre">@movie.Genre</span>@movie.Year</div>
                    </div>
                </a>
                rank++;
            }
            @if (!trending.Any())
            {
                <div style="color:#aaa; padding: 2rem; text-align:center; width:100%;">
                    Chưa có phim nào trong cơ sở dữ liệu. <a href="/Admin/Product/Create" style="color:#e50914;">Thêm phim</a>
                </div>
            }
        </div>
    </div>

    <!-- Expanded grid (all movies từ DB) -->
    <div class="trending__grid-wrap" id="allMoviesWrap">
        <div class="trending__grid" id="allMoviesGrid">
            @foreach (var movie in allMovies)
            {
                <a href="/Product/Detail/@movie.Id" class="t-card" style="display: block; text-decoration: none; color: inherit;">
                    <img class="t-card__img"
                         src="@movie.ImageUrl"
                         onerror="this.onerror=null;this.src='/images/movies/default.jpg'"
                         alt="@movie.Title" loading="lazy" />
                    <div class="t-card__play"><svg width="18" height="18" viewBox="0 0 24 24" fill="white">
                            <path d="M8 5v14l11-7z" /></svg></div>
                    <div class="t-card__info">
                        <div class="t-card__name">@movie.Title</div>
                        <div class="t-card__meta"><span class="t-card__genre">@movie.Genre</span>@movie.Year</div>
                    </div>
                </a>
            }
        </div>
    </div>
</section>

<div class="divider"></div>

<!-- ══════════════════════════════════════
     FEATURES
══════════════════════════════════════ -->
<section class="features">
    <div class="container">
        <div class="features__header">
            <div class="section-eyebrow" data-i18n="feat.eyebrow">Tại Sao Chọn FILMIX?</div>
            <h2 class="section-title" data-i18n="feat.title">Trải Nghiệm Không Thể So Sánh</h2>
            <p class="section-sub" data-i18n="feat.sub">Mọi thứ bạn cần, tất cả ở một nơi.</p>
        </div>

        <div class="features__grid">
            <div class="f-card">
                <div class="f-card__icon">
                    <svg viewBox="0 0 24 24">
                        <path
                            d="M21 3H3c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h5v2h8v-2h5c1.1 0 1.99-.9 1.99-2L23 5c0-1.1-.9-2-2-2zm0 14H3V5h18v12z" />
                    </svg>
                </div>
                <h3 class="f-card__title" data-i18n="feat.tv.title">Xem Trên TV</h3>
                <p class="f-card__desc" data-i18n="feat.tv.desc">Tương thích Smart TV, PlayStation, Xbox, Chromecast, Apple TV và hơn 1000 thiết bị khác với chất lượng 4K HDR.</p>
            </div>

            <div class="f-card">
                <div class="f-card__icon">
                    <svg viewBox="0 0 24 24">
                        <path d="M19 9h-4V3H9v6H5l7 7 7-7zm-8 2V5h2v6h1.17L12 13.17 9.83 11H11zm-6 7h14v2H5z" />
                    </svg>
                </div>
                <h3 class="f-card__title" data-i18n="feat.dl.title">Tải Về Offline</h3>
                <p class="f-card__desc" data-i18n="feat.dl.desc">Lưu phim yêu thích và xem khi không có mạng. Hoàn hảo cho chuyến đi máy bay, tàu hỏa hay mọi nơi.</p>
            </div>

            <div class="f-card">
                <div class="f-card__icon">
                    <svg viewBox="0 0 24 24">
                        <path
                            d="M1 9l2 2c4.97-4.97 13.03-4.97 18 0l2-2C16.93 2.93 7.08 2.93 1 9zm8 8l3 3 3-3c-1.65-1.66-4.34-1.66-6 0zm-4-4 2 2c2.76-2.76 7.24-2.76 10 0l2-2C15.14 9.14 8.87 9.14 5 13z" />
                    </svg>
                </div>
                <h3 class="f-card__title" data-i18n="feat.dev.title">Mọi Thiết Bị</h3>
                <p class="f-card__desc" data-i18n="feat.dev.desc">Stream trên điện thoại, tablet, laptop và TV cùng lúc mà không tốn thêm phí — một gói, mọi màn hình.</p>
            </div>

            <div class="f-card">
                <div class="f-card__icon">
                    <svg viewBox="0 0 24 24">
                        <path
                            d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
                    </svg>
                </div>
                <h3 class="f-card__title" data-i18n="feat.kids.title">Hồ Sơ Trẻ Em</h3>
                <p class="f-card__desc" data-i18n="feat.kids.desc">Không gian riêng an toàn cho trẻ với nội dung được kiểm duyệt. Cha mẹ kiểm soát hoàn toàn qua PIN.</p>
            </div>
        </div>
    </div>
</section>

<div class="divider"></div>

<!-- ══════════════════════════════════════
     FAQ
══════════════════════════════════════ -->
<section class="faq">
    <div class="container">
        <div class="faq__header">
            <div class="section-eyebrow" data-i18n="faq.eyebrow">Hỗ Trợ</div>
            <h2 class="section-title" data-i18n="faq.title">Câu Hỏi Thường Gặp</h2>
        </div>

        <div class="faq__list">
            <div class="faq__item">
                <button class="faq__q" onclick="toggleFAQ(this)"><span data-i18n="faq.q1">FILMIX là gì?</span><span class="faq__icon">+</span></button>
                <div class="faq__a">
                    <p data-i18n="faq.a1">FILMIX là dịch vụ streaming cung cấp hàng nghìn bộ phim, series, anime và tài liệu đoạt giải thưởng. Xem bao nhiêu tùy thích, bất cứ lúc nào — chỉ với một mức phí hàng tháng cố định, không quảng cáo, không hợp đồng ràng buộc.</p>
                </div>
            </div>
            <div class="faq__item">
                <button class="faq__q" onclick="toggleFAQ(this)"><span data-i18n="faq.q2">FILMIX có giá bao nhiêu?</span><span class="faq__icon">+</span></button>
                <div class="faq__a">
                    <p data-i18n="faq.a2">Chúng tôi có ba gói: Cơ Bản 79.000đ/tháng, Tiêu Chuẩn Full HD 149.000đ/tháng, và Premium 4K UHD 249.000đ/tháng (4 màn hình đồng thời). Tất cả đều có 30 ngày dùng thử miễn phí, hủy bất cứ lúc nào.</p>
                </div>
            </div>
            <div class="faq__item">
                <button class="faq__q" onclick="toggleFAQ(this)"><span data-i18n="faq.q3">Tôi có thể xem ở đâu?</span><span class="faq__icon">+</span></button>
                <div class="faq__a">
                    <p data-i18n="faq.a3">Xem mọi lúc, mọi nơi trên bất kỳ thiết bị nào — Smart TV, điện thoại, máy tính bảng, laptop, Apple TV hay máy chơi game. Tải ứng dụng iOS, Android hoặc Windows để xem offline khi không có mạng.</p>
                </div>
            </div>
            <div class="faq__item">
                <button class="faq__q" onclick="toggleFAQ(this)"><span data-i18n="faq.q4">Làm thế nào để hủy đăng ký?</span><span class="faq__icon">+</span></button>
                <div class="faq__a">
                    <p data-i18n="faq.a4">FILMIX hoàn toàn linh hoạt. Bạn có thể hủy tài khoản trực tuyến trong vài giây từ trang cài đặt tài khoản. Không có phí hủy — bắt đầu hoặc dừng bất cứ lúc nào.</p>
                </div>
            </div>
            <div class="faq__item">
                <button class="faq__q" onclick="toggleFAQ(this)"><span data-i18n="faq.q5">Nội dung có phụ đề tiếng Việt không?</span><span class="faq__icon">+</span></button>
                <div class="faq__a">
                    <p data-i18n="faq.a5">Có! Hơn 90% nội dung có phụ đề tiếng Việt và nhiều ngôn ngữ khác. Nhiều bộ phim còn có lồng tiếng Việt chất lượng cao. Bạn có thể chuyển đổi ngôn ngữ ngay trong khi xem.</p>
                </div>
            </div>
            <div class="faq__item">
                <button class="faq__q" onclick="toggleFAQ(this)"><span data-i18n="faq.q6">FILMIX có phù hợp cho trẻ em không?</span><span class="faq__icon">+</span></button>
                <div class="faq__a">
                    <p data-i18n="faq.a6">Hoàn toàn phù hợp! Hồ sơ Kids với giao diện thân thiện và nội dung được kiểm duyệt kỹ theo độ tuổi. Cha mẹ cài đặt PIN bảo vệ và giới hạn nội dung theo rating để đảm bảo an toàn cho trẻ.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="divider"></div>

<!-- ══════════════════════════════════════
     FINAL CTA
══════════════════════════════════════ -->
<section class="final-cta" id="finalCta">
    <div class="final-cta__inner">
        <div class="section-eyebrow" data-i18n="cta.eyebrow">Sẵn Sàng Chưa?</div>
        <h2 class="section-title" data-i18n="cta.title">Tham Gia FILMIX Ngay Hôm Nay</h2>
        <p class="final-cta__sub" data-i18n="cta.sub">
            Hàng nghìn bộ phim, series và nhiều hơn nữa. Khám phá tất cả miễn phí trong 30 ngày đầu — không cần thẻ tín dụng.
        </p>
        <div class="final-cta__actions">
            <a asp-controller="Account" asp-action="Auth" asp-route-mode="signup" class="btn btn-red">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M8 5v14l11-7z" />
                </svg>
                Bắt Đầu Xem Ngay
            </a>
            <a href="#" class="btn btn-ghost">Xem Bảng Giá</a>
        </div>
    </div>
</section>

@section Scripts {
    <!-- Hero Banner JS -->
    <script src="~/js/hero-banner.js" asp-append-version="true"></script>

    <script>
        /* ── Navbar scroll ── */
        const nav = document.getElementById('nav');
        window.addEventListener('scroll', () => {
            nav.classList.toggle('scrolled', window.scrollY > 50);
        }, { passive: true });

        /* ── Clear all Continue Watching ── */
        function clearAllCW() {
            if (!confirm('Bạn có chắc muốn xóa toàn bộ lịch sử xem?')) return;
            // Remove all filmix_progress_* keys
            Object.keys(localStorage)
                .filter(k => k.startsWith('filmix_progress_'))
                .forEach(k => localStorage.removeItem(k));
            localStorage.removeItem('filmix_cw_order');
            // Hide section
            const section = document.getElementById('cwSection');
            if (section) section.classList.remove('has-items');
            const track = document.getElementById('cwTrack');
            if (track) track.innerHTML = '';
        }

        /* ── FAQ accordion ── */
        function toggleFAQ(btn) {
            const item = btn.closest('.faq__item');
            const isOpen = item.classList.contains('open');
            document.querySelectorAll('.faq__item').forEach(el => el.classList.remove('open'));
            if (!isOpen) item.classList.add('open');
        }

        /* ── Floating particles ── */
        (function () {
            const c = document.getElementById('particles');
            if (!c) return;
            for (let i = 0; i < 20; i++) {
                const p = document.createElement('div');
                p.className = 'particle';
                const sz = Math.random() * 5 + 2;
                p.style.cssText = `width:${sz}px;height:${sz}px;left:${Math.random() * 100}%;animation-duration:${Math.random() * 13 + 9}s;animation-delay:${Math.random() * 14}s;`;
                c.appendChild(p);
            }
        })();

        /* ── Trending drag-to-scroll ── */
        (function () {
            const tr = document.getElementById('trendingTrack');
            if (!tr) return;
            let isDown = false, startX, sl;
            tr.addEventListener('mousedown', e => { isDown = true; startX = e.pageX - tr.offsetLeft; sl = tr.scrollLeft; });
            tr.addEventListener('mouseleave', () => isDown = false);
            tr.addEventListener('mouseup', () => isDown = false);
            tr.addEventListener('mousemove', e => {
                if (!isDown) return; e.preventDefault();
                tr.scrollLeft = sl - (e.pageX - tr.offsetLeft - startX) * 1.4;
            });
        })();

        /* ── Feature cards IntersectionObserver ── */
        const featureObs = new IntersectionObserver(entries => {
            entries.forEach((entry, i) => {
                if (entry.isIntersecting) {
                    setTimeout(() => entry.target.classList.add('visible'), i * 100);
                    featureObs.unobserve(entry.target);
                }
            });
        }, { threshold: 0.12 });
        document.querySelectorAll('.f-card').forEach(c => featureObs.observe(c));

        /* ── All Movies expand/collapse (dữ liệu từ server-rendered HTML) ── */
        let allMoviesOpen = false;

        function toggleAllMovies() {
            const wrap = document.getElementById('allMoviesWrap');
            const btn  = document.getElementById('seeAllBtn');

            allMoviesOpen = !allMoviesOpen;

            if (allMoviesOpen) {
                wrap.classList.add('open');
                btn.classList.add('expanded');
                btn.innerHTML = `Thu Gọn <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z"/></svg>`;
                setTimeout(() => wrap.scrollIntoView({ behavior: 'smooth', block: 'start' }), 50);
            } else {
                wrap.classList.remove('open');
                btn.classList.remove('expanded');
                btn.innerHTML = `Xem Tất Cả <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z"/></svg>`;
            }
        }
    </script>
}
