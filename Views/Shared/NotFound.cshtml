@{
    ViewData["Title"] = "404 - Không Tìm Thấy";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .notfound-page {
        min-height: 100vh;
        background: #141414;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 80px 20px;
        font-family: 'Outfit', sans-serif;
        overflow: hidden;
        position: relative;
    }

    /* Animated background noise */
    .notfound-bg {
        position: absolute;
        inset: 0;
        background:
            radial-gradient(ellipse at 20% 50%, rgba(229, 9, 20, 0.08) 0%, transparent 60%),
            radial-gradient(ellipse at 80% 20%, rgba(229, 9, 20, 0.05) 0%, transparent 50%);
        animation: bgPulse 6s ease-in-out infinite alternate;
    }

    @@keyframes bgPulse {
        from { opacity: 0.6; }
        to   { opacity: 1; }
    }

    .notfound-content {
        position: relative;
        z-index: 2;
        text-align: center;
        max-width: 650px;
    }

    /* Big glitchy 404 number */
    .notfound-code {
        font-size: clamp(6rem, 20vw, 12rem);
        font-weight: 900;
        color: #e50914;
        line-height: 1;
        margin-bottom: 10px;
        letter-spacing: -4px;
        position: relative;
        display: inline-block;
        animation: glitch 4s infinite;
        text-shadow:
            0 0 40px rgba(229, 9, 20, 0.5),
            0 0 80px rgba(229, 9, 20, 0.2);
    }

    @@keyframes glitch {
        0%, 90%, 100% { transform: translate(0); filter: none; }
        91% { transform: translate(-3px, 1px); filter: hue-rotate(90deg); }
        92% { transform: translate(3px, -1px); filter: hue-rotate(-90deg); }
        93% { transform: translate(0); filter: none; }
        94% { transform: translate(2px, 2px); filter: hue-rotate(45deg); }
        95% { transform: translate(0); filter: none; }
    }

    .notfound-subtitle {
        font-size: clamp(1.2rem, 3vw, 1.8rem);
        font-weight: 700;
        color: #fff;
        margin-bottom: 16px;
    }

    .notfound-desc {
        font-size: 1rem;
        color: #aaa;
        line-height: 1.6;
        margin-bottom: 40px;
    }

    .notfound-actions {
        display: flex;
        gap: 16px;
        justify-content: center;
        flex-wrap: wrap;
    }

    .notfound-btn {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 13px 28px;
        font-size: 1rem;
        font-weight: 700;
        border-radius: 6px;
        text-decoration: none;
        transition: all 0.25s ease;
        cursor: pointer;
        border: none;
    }

    .notfound-btn--red {
        background: #e50914;
        color: #fff;
    }
    .notfound-btn--red:hover {
        background: #f40612;
        transform: scale(1.04);
        box-shadow: 0 8px 24px rgba(229, 9, 20, 0.4);
    }

    .notfound-btn--ghost {
        background: rgba(255,255,255,0.12);
        color: #fff;
        border: 1px solid rgba(255,255,255,0.2);
        backdrop-filter: blur(10px);
    }
    .notfound-btn--ghost:hover {
        background: rgba(255,255,255,0.22);
        transform: scale(1.04);
    }

    /* Film strip decoration */
    .film-strip {
        display: flex;
        gap: 8px;
        justify-content: center;
        margin-bottom: 40px;
        overflow: hidden;
        height: 70px;
        opacity: 0.18;
    }

    .film-cell {
        width: 60px;
        height: 70px;
        background: #333;
        border-radius: 3px;
        border: 1px solid #444;
        flex-shrink: 0;
        position: relative;
        overflow: hidden;
        animation: filmScroll 8s linear infinite;
    }

    .film-cell::before,
    .film-cell::after {
        content: '';
        position: absolute;
        left: 50%;
        transform: translateX(-50%);
        width: 10px;
        height: 7px;
        background: #555;
        border-radius: 2px;
    }
    .film-cell::before { top: 4px; }
    .film-cell::after  { bottom: 4px; }

    @@keyframes filmScroll {
        0%   { transform: translateX(0); }
        100% { transform: translateX(-68px); }
    }

    .notfound-divider {
        width: 60px;
        height: 3px;
        background: #e50914;
        margin: 0 auto 24px;
        border-radius: 2px;
    }
</style>

<div class="notfound-page">
    <div class="notfound-bg"></div>

    <div class="notfound-content">
        <!-- Film strip decoration -->
        <div class="film-strip" aria-hidden="true">
            @for (int i = 0; i < 14; i++) {
                <div class="film-cell"></div>
            }
        </div>

        <div class="notfound-code" aria-label="Lỗi 404">404</div>

        <div class="notfound-divider"></div>

        <h1 class="notfound-subtitle">Ồ không! Trang này đã biến mất</h1>
        <p class="notfound-desc">
            Trang bạn đang tìm kiếm có thể đã bị xóa, đổi tên,<br>
            hoặc tạm thời không khả dụng. Hãy thử lại nhé!
        </p>

        <div class="notfound-actions">
            <a href="/" class="notfound-btn notfound-btn--red">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/>
                </svg>
                Về Trang Chủ
            </a>
            <a href="/Product/List" class="notfound-btn notfound-btn--ghost">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M18 4l2 4h-3l-2-4h-2l2 4h-3l-2-4H8l2 4H7L5 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V4h-4z"/>
                </svg>
                Xem Phim
            </a>
            <button onclick="history.back()" class="notfound-btn notfound-btn--ghost">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/>
                </svg>
                Quay Lại
            </button>
        </div>
    </div>
</div>
