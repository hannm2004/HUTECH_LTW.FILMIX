@model untitled1.Models.Entities.Movie

@if (Model != null)
{
    var hasVideo = !string.IsNullOrWhiteSpace(Model.TrailerUrl);
    
    <div id="heroBanner" class="hero-banner" data-video-url="@(hasVideo ? Model.TrailerUrl : "")" role="region" aria-label="Phim nổi bật">
        <!-- ── Background Image ── -->
        <div class="hero-banner__bg" style="background-image: url('@Model.ImageUrl');" onerror="this.style.backgroundImage=&quot;url('/images/movies/default.jpg')&quot;"></div>

        <!-- ── Video Layer (autoplay muted loop) ── -->
        <div class="hero-banner__video-wrap" id="heroVideoWrap">
            <video id="heroBannerVideo" class="hero-banner__video" muted playsinline loop preload="none" aria-hidden="true"></video>
        </div>

        <!-- ── Cinematic Gradient Overlay ── -->
        <div class="hero-banner__gradient" aria-hidden="true"></div>

        <!-- ── Content Panel ── -->
        <div class="hero-banner__content" id="heroBannerContent">
            <div class="hero-banner__meta-row">
                <span class="hero-banner__chip hero-banner__chip--new">▶ Nổi Bật</span>
                @if (!string.IsNullOrWhiteSpace(Model.Genre))
                {
                    <span class="hero-banner__chip hero-banner__chip--genre">@Model.Genre</span>
                }
                @if (Model.Year > 0)
                {
                    <span class="hero-banner__chip hero-banner__chip--year">@Model.Year</span>
                }
                @if (Model.IsTVSeries)
                {
                    <span class="hero-banner__chip hero-banner__chip--genre">TV Series</span>
                }
            </div>

            <h1 class="hero-banner__title">@Model.Title</h1>

            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <p class="hero-banner__desc">@Model.Description</p>
            }

            <div class="hero-banner__actions">
                <a href="/Product/Detail/@Model.Id" class="hb-btn hb-btn--play">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M8 5v14l11-7z"/>
                    </svg>
                    Phát
                </a>
                <a href="/Product/Detail/@Model.Id" class="hb-btn hb-btn--info">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/>
                    </svg>
                    Thông Tin Khác
                </a>
            </div>
        </div>

        <!-- ── Mute / Unmute Button ── -->
        <button class="hero-banner__mute" id="heroMuteBtn" aria-label="Bật tiếng" title="Bật/Tắt tiếng" style="display: none;">
            <svg class="icon-mute" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z"/>
            </svg>
            <svg class="icon-unmute" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" style="display:none;">
                <path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/>
            </svg>
        </button>
    </div>
}
else
{
    <section class="hero hero-banner--fallback">
        <div class="hero__bg"></div>
        <div class="hero__particles" id="particles" aria-hidden="true"></div>
        <div class="hero__overlay"></div>
        <div class="hero__inner">
            <div class="hero__content">
                <div class="hero__badge">Phim Mới Mỗi Tuần</div>
                <h1 class="hero__title">
                    <span class="thin">Trải Nghiệm</span>
                    <span>XEM PHIM</span><br><span class="red">KHÔNG GIỚI HẠN</span>
                </h1>
                <p class="hero__sub">
                    Hàng nghìn bộ phim, series nổi tiếng, anime &amp; tài liệu hấp dẫn — xem mọi lúc, mọi nơi, trên mọi thiết bị. Hủy bất cứ lúc nào.
                </p>
                <div class="hero__actions">
                    <a href="/Account/Auth?mode=signup" class="btn btn-red">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                        Đăng Ký Ngay
                    </a>
                </div>
            </div>
        </div>
    </section>
}
