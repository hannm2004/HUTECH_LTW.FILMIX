<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FILMIX</title>
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/hero-banner.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/hover-preview.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/continue-watching.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/search.css" asp-append-version="true" />
    <script src="~/js/i18n.js"></script>
    <script src="~/js/auth-state.js"></script>
</head>
<body>
    <!-- NAVBAR -->
    <nav class="nav" id="nav">
        <a asp-area="" asp-controller="Home" asp-action="Index" class="nav__logo">FILM<span>IX</span></a>

        <div class="nav__links">
            <a asp-area="" asp-controller="Home" asp-action="Index" data-i18n="nav.home">Trang Chủ</a>
            <a asp-area="" asp-controller="TVShows" asp-action="Index" data-i18n="nav.tvShows">TV Shows</a>
            <a asp-area="" asp-controller="Movies" asp-action="Index" data-i18n="nav.movies">Phim Lẻ</a>
            <a asp-area="" asp-controller="NewHot" asp-action="Index" data-i18n="nav.newHot">Mới &amp; Hot</a>
            <a asp-area="" asp-controller="Watchlist" asp-action="Index" data-i18n="nav.watchlist">Danh Sách</a>
        </div>

        <div class="nav__right">
            <!-- Search Bar -->
            <div class="nav__search" id="navSearch">
                <button class="nav__search-toggle" id="searchToggle" aria-label="Tìm kiếm" title="Tìm kiếm" onclick="toggleNavSearch()">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
                        <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
                    </svg>
                </button>
                <form class="nav__search-form" id="navSearchForm" action="/Search" method="get" role="search" autocomplete="off">
                    <input type="text" name="q" id="navSearchInput"
                           class="nav__search-input"
                           placeholder="Tìm phim, diễn viên..."
                           aria-label="Tìm kiếm phim"
                           oninput="onNavSearchInput(this.value)"
                           onkeydown="onNavSearchKey(event)" />
                    <button type="submit" class="nav__search-submit" aria-label="Tìm">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                            <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
                        </svg>
                    </button>
                </form>
                <div class="nav__search-dropdown" id="navSearchDropdown"></div>
            </div>

            <!-- Language Switcher -->
            <div class="lang-switcher" id="langSwitcher">
                <button class="lang-btn" id="langBtn" onclick="toggleLang()">
                    <span id="langFlag">🇻🇳</span>
                    <span id="langLabel">Tiếng Việt</span>
                    <svg class="chevron" width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M7 10l5 5 5-5z" />
                    </svg>
                </button>
                <div class="lang-dropdown" id="langDropdown">
                    <a href="#" data-lang="vi" onclick="return setLanguage('vi','🇻🇳','Tiếng Việt')"><span class="flag">🇻🇳</span> Tiếng Việt</a>
                    <a href="#" data-lang="en" onclick="return setLanguage('en','🇺🇸','English')"><span class="flag">🇺🇸</span> English</a>
                    <a href="#" data-lang="ko" onclick="return setLanguage('ko','🇰🇷','한국어')"><span class="flag">🇰🇷</span> 한국어</a>
                    <a href="#" data-lang="ja" onclick="return setLanguage('ja','🇯🇵','日本語')"><span class="flag">🇯🇵</span> 日本語</a>
                    <a href="#" data-lang="zh" onclick="return setLanguage('zh','🇨🇳','中文')"><span class="flag">🇨🇳</span> 中文</a>
                    <a href="#" data-lang="fr" onclick="return setLanguage('fr','🇫🇷','Français')"><span class="flag">🇫🇷</span> Français</a>
                    <a href="#" data-lang="es" onclick="return setLanguage('es','🇪🇸','Español')"><span class="flag">🇪🇸</span> Español</a>
                    <a href="#" data-lang="th" onclick="return setLanguage('th','🇹🇭','ภาษาไทย')"><span class="flag">🇹🇭</span> ภาษาไทย</a>
                </div>
            </div>

            <a asp-controller="Account" asp-action="Auth" class="nav__signin" id="navSignin" data-i18n="nav.login">Đăng Nhập</a>

            <div class="nav__profile" id="navProfile" style="display:none;">
                <div class="nav__avatar" id="navAvatar"></div>
                <span class="nav__username" id="navUsername"></span>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="nav__admin-link" style="color: #fff; background: var(--red); padding: 7px 16px; border-radius: 4px; font-weight: 700; text-decoration: none; margin-right: 10px; font-size: 0.82rem; transition: all 0.25s;" onmouseover="this.style.background='#b00610'" onmouseout="this.style.background='var(--red)'">Quản Trị</a>
                }
                <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline;margin:0;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="nav__logout" data-i18n="nav.logout">Đăng Xuất</button>
                </form>
            </div>
        </div>
    </nav>

    <div class="welcome-bar" id="welcomeBar" style="display:none;">
        <span id="welcomeGreet" data-i18n="welcome.greeting">Chào mừng trở lại,</span>
        &nbsp;<strong id="welcomeName"></strong>
    </div>

    <main role="main">
        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer class="footer">
        <div class="footer__top">
            <div class="footer__logo">FILMIX</div>
            <div class="footer__social">
                <a href="#" title="Facebook">f</a>
                <a href="#" title="Instagram">ig</a>
                <a href="#" title="Twitter/X">𝕏</a>
                <a href="#" title="YouTube">▶</a>
                <a href="#" title="TikTok">tt</a>
            </div>
        </div>

        <div class="footer__grid">
            <div class="footer__col">
                <h4>Hỗ Trợ</h4>
                <ul>
                    <li><a href="#">Câu Hỏi Thường Gặp</a></li>
                    <li><a href="#">Trung Tâm Trợ Giúp</a></li>
                    <li><a href="#">Liên Hệ</a></li>
                    <li><a href="#">Kiểm Tra Tốc Độ</a></li>
                    <li><a href="#">Báo Cáo Lỗi</a></li>
                </ul>
            </div>
            <div class="footer__col">
                <h4>Tài Khoản</h4>
                <ul>
                    <li><a href="#">Quản Lý Tài Khoản</a></li>
                    <li><a href="#">Đổi Mật Khẩu</a></li>
                    <li><a href="#">Lịch Sử Xem</a></li>
                    <li><a asp-controller="Product" asp-action="List" asp-fragment="watchlist">Danh Sách Của Tôi</a></li>
                    <li><a href="#">Hủy Đăng Ký</a></li>
                </ul>
            </div>
            <div class="footer__col">
                <h4>Công Ty</h4>
                <ul>
                    <li><a href="#">Giới Thiệu</a></li>
                    <li><a href="#">Truyền Thông</a></li>
                    <li><a href="#">Quan Hệ Đầu Tư</a></li>
                    <li><a href="#">Việc Làm</a></li>
                    <li><a href="#">Blog</a></li>
                </ul>
            </div>
            <div class="footer__col">
                <h4>Nội Dung</h4>
                <ul>
                    <li><a href="#">Phim Mới</a></li>
                    <li><a href="#">Series Hot</a></li>
                    <li><a href="#">Anime</a></li>
                    <li><a href="#">Tài Liệu</a></li>
                    <li><a href="#">Phim Cho Bé</a></li>
                </ul>
            </div>
            <div class="footer__col">
                <h4>Pháp Lý</h4>
                <ul>
                    <li><a href="#">Điều Khoản</a></li>
                    <li><a href="#">Chính Sách Bảo Mật</a></li>
                    <li><a href="#">Cookie</a></li>
                    <li><a href="#">Thông Báo Pháp Lý</a></li>
                    <li><a href="#">Khả Năng Truy Cập</a></li>
                </ul>
            </div>
        </div>

        <div class="footer__bottom">
            <p class="footer__copy">© 2025 FILMIX Vietnam. Bảo lưu mọi quyền.</p>
            <div class="footer__bottom-links">
                <a href="#">Chính Sách Bảo Mật</a>
                <a href="#">Điều Khoản</a>
                <a href="#">Cookie</a>
                <a href="#">Sơ Đồ Trang</a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/hover-preview.js" asp-append-version="true"></script>
    <script src="~/js/netflix-slider.js" asp-append-version="true"></script>
    <script src="~/js/continue-watching.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
    /* ══════════════════════════════════════════
       Navbar Search — Toggle + Autocomplete
    ══════════════════════════════════════════ */
    (function () {
        let _debounceTimer = null;
        let _selectedIdx   = -1;
        let _suggestions   = [];

        window.toggleNavSearch = function (forceOpen) {
            const form     = document.getElementById('navSearchForm');
            const input    = document.getElementById('navSearchInput');
            const isOpen   = form.classList.contains('open');
            const open     = forceOpen !== undefined ? forceOpen : !isOpen;
            form.classList.toggle('open', open);
            if (open) { setTimeout(() => input?.focus(), 80); }
            else       { closeDropdown(); }
        };

        window.onNavSearchInput = function (val) {
            clearTimeout(_debounceTimer);
            _selectedIdx = -1;
            if (!val || val.length < 2) { closeDropdown(); return; }
            _debounceTimer = setTimeout(() => fetchSuggestions(val), 220);
        };

        window.onNavSearchKey = function (e) {
            const dropdown = document.getElementById('navSearchDropdown');
            const items    = dropdown.querySelectorAll('.search-suggest-item');
            if (e.key === 'ArrowDown')  { e.preventDefault(); moveSel(items, 1);  }
            else if (e.key === 'ArrowUp') { e.preventDefault(); moveSel(items, -1); }
            else if (e.key === 'Escape') { toggleNavSearch(false); }
            else if (e.key === 'Enter' && _selectedIdx >= 0) {
                e.preventDefault();
                const link = items[_selectedIdx]?.getAttribute('href');
                if (link) window.location.href = link;
            }
        };

        function moveSel(items, dir) {
            items.forEach(el => el.classList.remove('selected'));
            _selectedIdx = Math.max(-1, Math.min(_selectedIdx + dir, items.length - 1));
            if (_selectedIdx >= 0) {
                items[_selectedIdx].classList.add('selected');
                items[_selectedIdx].style.background = 'rgba(255,255,255,0.1)';
            }
        }

        function closeDropdown() {
            const dd = document.getElementById('navSearchDropdown');
            if (dd) { dd.classList.remove('open'); dd.innerHTML = ''; }
            _selectedIdx = -1;
            _suggestions = [];
        }

        async function fetchSuggestions(q) {
            try {
                const res  = await fetch('/api/search/suggest?q=' + encodeURIComponent(q));
                const data = await res.json();
                renderDropdown(data, q);
            } catch { closeDropdown(); }
        }

        function renderDropdown(items, q) {
            const dd = document.getElementById('navSearchDropdown');
            if (!dd) return;
            if (!items || items.length === 0) { closeDropdown(); return; }

            _suggestions = items;
            const esc = (s) => s.replace(/[<>&"]/g, c => ({'<':'&lt;','>':'&gt;','&':'&amp;','"':'&quot;'}[c]));
            const highlight = (text) => {
                const re = new RegExp('(' + q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + ')', 'gi');
                return esc(text).replace(re, '<mark class="search-highlight">$1</mark>');
            };

            dd.innerHTML = items.map(m => `
                <a class="search-suggest-item" href="/Product/Detail/${m.id}">
                    <img src="${esc(m.imageUrl || '/images/movies/default.jpg')}" alt="${esc(m.title)}"
                         onerror="this.src='/images/movies/default.jpg'" />
                    <div class="search-suggest-item__info">
                        <div class="search-suggest-item__title">${highlight(m.title)}</div>
                        <div class="search-suggest-item__meta">${m.year} &bull; ${esc(m.genre || '')}</div>
                    </div>
                    <span class="search-suggest-item__badge ${m.isTVSeries ? 'badge-series' : 'badge-movie'}">
                        ${m.isTVSeries ? 'Series' : 'Phim'}
                    </span>
                </a>
            `).join('') +
            `<a class="search-suggest-viewall" href="/Search?q=${encodeURIComponent(q)}">Xem tất cả kết quả &rarr;</a>`;

            dd.classList.add('open');
        }

        // Close on click outside
        document.addEventListener('click', (e) => {
            const wrap = document.getElementById('navSearch');
            if (wrap && !wrap.contains(e.target)) {
                toggleNavSearch(false);
            }
        });
    })();
    </script>
    @* Sync server-side auth state to localStorage so client-side UI stays consistent *@
    @if (User.Identity?.IsAuthenticated == true)
    {
        <script>
            if (!localStorage.getItem('filmix_user')) {
                localStorage.setItem('filmix_user', JSON.stringify({ name: '@User.Identity.Name', email: '@User.Identity.Name' }));
            }
        </script>
    }
    else
    {
        <script>localStorage.removeItem('filmix_user');</script>
    }
</body>
</html>
