@inject untitled1.Services.ICartService CartService
@{
    var cartCount = CartService.GetCart().Sum(i => i.Quantity);
    var showExpiryWarning = false;
    double? daysRemaining = null;
    if (User.Identity?.IsAuthenticated == true)
    {
        var userManager = Context.RequestServices.GetRequiredService<Microsoft.AspNetCore.Identity.UserManager<untitled1.Models.Entities.ApplicationUser>>();
        var currentUser = userManager.GetUserAsync(User).Result;
        if (currentUser != null && currentUser.PremiumEndDate.HasValue)
        {
            var timeLeft = currentUser.PremiumEndDate.Value - DateTime.Now;
            if (timeLeft.TotalDays > 0 && timeLeft.TotalDays <= 3)
            {
                showExpiryWarning = true;
                daysRemaining = Math.Round(timeLeft.TotalDays, 1);
            }
        }
    }
}
