    <script>
        /* ── Auth Required Modal ── */
        function requireAuth(title, desc, returnUrl) {
            const isAuth = document.cookie.split(';').some(c => c.trim().startsWith('.AspNetCore.Identity.Application='))
                        || (localStorage.getItem('filmix_user') !== null);
            if (isAuth) return true; // already logged in, allow action
            // Show modal
            const modal = document.getElementById('authRequiredModal');
            const btn   = document.getElementById('authModalLoginBtn');
            if (document.getElementById('authModalTitle'))  document.getElementById('authModalTitle').textContent  = title  || 'Đăng nhập để tiếp tục';
            if (document.getElementById('authModalDesc'))   document.getElementById('authModalDesc').textContent   = desc   || 'Bạn cần đăng nhập để sử dụng tính năng này.';
            if (btn && returnUrl) btn.href = '/Account/Auth?returnUrl=' + encodeURIComponent(returnUrl);
            modal.style.display = 'flex';
            document.body.style.overflow = 'hidden';
            return false; // block action
        }
        function closeAuthModal() {
            const modal = document.getElementById('authRequiredModal');
            modal.style.display = 'none';
            document.body.style.overflow = '';
        }
        document.getElementById('authRequiredModal').addEventListener('click', function(e) {
            if (e.target === this) closeAuthModal();
        });
    </script>

