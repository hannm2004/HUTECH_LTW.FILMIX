<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/hover-preview.css" asp-append-version="true" />
    <script src="~/js/i18n.js"></script>
    <script src="~/js/auth-state.js"></script>
</head>
<body>
    <!-- NAVBAR -->
    <nav class="nav" id="nav">
        <a asp-area="" asp-controller="Home" asp-action="Index" class="nav__logo">FILM<span>IX</span></a>

        <div class="nav__links">
            <a asp-area="" asp-controller="Home" asp-action="Index" data-i18n="nav.home">Trang Chủ</a>
            <a asp-area="" asp-controller="TVShows" asp-action="Index" data-i18n="nav.tvShows">TV Shows</a>
            <a asp-area="" asp-controller="Movies" asp-action="Index" data-i18n="nav.movies">Phim Lẻ</a>
            <a asp-area="" asp-controller="NewHot" asp-action="Index" data-i18n="nav.newHot">Mới &amp; Hot</a>
            <a asp-area="" asp-controller="Product" asp-action="List" data-i18n="nav.watchlist">Danh Sách</a>
        </div>

        <div class="nav__right">
            <!-- Live Search -->
            <div class="nav__search" style="position: relative; margin-right: 15px;">
                <div style="display: flex; align-items: center; background: rgba(0,0,0,0.5); border: 1px solid rgba(255,255,255,0.2); border-radius: 4px; padding: 4px 10px; transition: all 0.3s ease;" onfocusin="this.style.borderColor='#e50914'; this.style.background='rgba(0,0,0,0.8)';" onfocusout="this.style.borderColor='rgba(255,255,255,0.2)'; this.style.background='rgba(0,0,0,0.5)';">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" style="color: #aaa; margin-right: 8px;"><path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
                    <input type="text" id="liveSearchInput" placeholder="Tìm tên, diễn viên..." style="background: transparent; border: none; color: #fff; width: 160px; font-size: 0.9rem; outline: none; transition: width 0.3s ease;" autocomplete="off" onfocus="this.style.width='220px'" onblur="this.value.trim() === '' ? this.style.width='160px' : null" />
                </div>
                <!-- Dropdown Results -->
                <div id="liveSearchResults" style="display: none; position: absolute; top: 100%; right: 0; width: 340px; background: rgba(20,20,20,0.98); border: 1px solid rgba(255,255,255,0.1); border-radius: 6px; margin-top: 10px; box-shadow: 0 10px 30px rgba(0,0,0,0.8); z-index: 100; max-height: 450px; overflow-y: auto;">
                </div>
            </div>

            <!-- Language Switcher -->
            <div class="lang-switcher" id="langSwitcher">
                <button class="lang-btn" id="langBtn" onclick="toggleLang()">
                    <span id="langFlag">🇻🇳</span>
                    <span id="langLabel">Tiếng Việt</span>
                    <svg class="chevron" width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M7 10l5 5 5-5z" />
                    </svg>
                </button>
                <div class="lang-dropdown" id="langDropdown">
                    <a href="#" data-lang="vi" onclick="return setLanguage('vi','🇻🇳','Tiếng Việt')"><span class="flag">🇻🇳</span> Tiếng Việt</a>
                    <a href="#" data-lang="en" onclick="return setLanguage('en','🇺🇸','English')"><span class="flag">🇺🇸</span> English</a>
                    <a href="#" data-lang="ko" onclick="return setLanguage('ko','🇰🇷','한국어')"><span class="flag">🇰🇷</span> 한국어</a>
                    <a href="#" data-lang="ja" onclick="return setLanguage('ja','🇯🇵','日本語')"><span class="flag">🇯🇵</span> 日本語</a>
                    <a href="#" data-lang="zh" onclick="return setLanguage('zh','🇨🇳','中文')"><span class="flag">🇨🇳</span> 中文</a>
                    <a href="#" data-lang="fr" onclick="return setLanguage('fr','🇫🇷','Français')"><span class="flag">🇫🇷</span> Français</a>
                    <a href="#" data-lang="es" onclick="return setLanguage('es','🇪🇸','Español')"><span class="flag">🇪🇸</span> Español</a>
                    <a href="#" data-lang="th" onclick="return setLanguage('th','🇹🇭','ภาษาไทย')"><span class="flag">🇹🇭</span> ภาษาไทย</a>
                </div>
            </div>

            <a asp-controller="Account" asp-action="Auth" class="nav__signin" id="navSignin" data-i18n="nav.login">Đăng Nhập</a>

            <div class="nav__profile" id="navProfile" style="display:none;">
                <div class="nav__avatar" id="navAvatar"></div>
                <span class="nav__username" id="navUsername"></span>
                <button class="nav__logout" onclick="logout()" data-i18n="nav.logout">Đăng Xuất</button>
            </div>
        </div>
    </nav>

    <div class="welcome-bar" id="welcomeBar" style="display:none;">
        <span id="welcomeGreet" data-i18n="welcome.greeting">Chào mừng trở lại,</span>
        &nbsp;<strong id="welcomeName"></strong>
    </div>

    <main role="main">
        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer class="footer">
        <div class="footer__top">
            <div class="footer__logo">FILMIX</div>
            <div class="footer__social">
                <a href="#" title="Facebook">f</a>
                <a href="#" title="Instagram">ig</a>
                <a href="#" title="Twitter/X">𝕏</a>
                <a href="#" title="YouTube">▶</a>
                <a href="#" title="TikTok">tt</a>
            </div>
        </div>

        <div class="footer__grid">
            <div class="footer__col">
                <h4>Hỗ Trợ</h4>
                <ul>
                    <li><a href="#">Câu Hỏi Thường Gặp</a></li>
                    <li><a href="#">Trung Tâm Trợ Giúp</a></li>
                    <li><a href="#">Liên Hệ</a></li>
                    <li><a href="#">Kiểm Tra Tốc Độ</a></li>
                    <li><a href="#">Báo Cáo Lỗi</a></li>
                </ul>
            </div>
            <div class="footer__col">
                <h4>Tài Khoản</h4>
                <ul>
                    <li><a href="#">Quản Lý Tài Khoản</a></li>
                    <li><a href="#">Đổi Mật Khẩu</a></li>
                    <li><a href="#">Lịch Sử Xem</a></li>
                    <li><a asp-controller="Product" asp-action="List" asp-fragment="watchlist">Danh Sách Của Tôi</a></li>
                    <li><a href="#">Hủy Đăng Ký</a></li>
                </ul>
            </div>
            <div class="footer__col">
                <h4>Công Ty</h4>
                <ul>
                    <li><a href="#">Giới Thiệu</a></li>
                    <li><a href="#">Truyền Thông</a></li>
                    <li><a href="#">Quan Hệ Đầu Tư</a></li>
                    <li><a href="#">Việc Làm</a></li>
                    <li><a href="#">Blog</a></li>
                </ul>
            </div>
            <div class="footer__col">
                <h4>Nội Dung</h4>
                <ul>
                    <li><a href="#">Phim Mới</a></li>
                    <li><a href="#">Series Hot</a></li>
                    <li><a href="#">Anime</a></li>
                    <li><a href="#">Tài Liệu</a></li>
                    <li><a href="#">Phim Cho Bé</a></li>
                </ul>
            </div>
            <div class="footer__col">
                <h4>Pháp Lý</h4>
                <ul>
                    <li><a href="#">Điều Khoản</a></li>
                    <li><a href="#">Chính Sách Bảo Mật</a></li>
                    <li><a href="#">Cookie</a></li>
                    <li><a href="#">Thông Báo Pháp Lý</a></li>
                    <li><a href="#">Khả Năng Truy Cập</a></li>
                </ul>
            </div>
        </div>

        <div class="footer__bottom">
            <p class="footer__copy">© 2025 FILMIX Vietnam. Bảo lưu mọi quyền.</p>
            <div class="footer__bottom-links">
                <a href="#">Chính Sách Bảo Mật</a>
                <a href="#">Điều Khoản</a>
                <a href="#">Cookie</a>
                <a href="#">Sơ Đồ Trang</a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/hover-preview.js" asp-append-version="true"></script>

    <!-- Live Search Logic -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const searchInput = document.getElementById('liveSearchInput');
            const searchResults = document.getElementById('liveSearchResults');
            let searchTimeout;

            if (searchInput) {
                searchInput.addEventListener('input', function() {
                    clearTimeout(searchTimeout);
                    const query = this.value.trim();
                    
                    if (query.length === 0) {
                        searchResults.style.display = 'none';
                        return;
                    }

                    searchTimeout = setTimeout(() => {
                        fetch('/api/search?q=' + encodeURIComponent(query))
                            .then(response => response.json())
                            .then(data => {
                                if (data.length === 0) {
                                    searchResults.innerHTML = '<div style="padding: 15px; text-align: center; color: #888; font-size: 0.95rem;">Không tìm thấy kết quả phù hợp</div>';
                                } else {
                                    let html = '<div style="padding: 10px 15px; font-size: 0.8rem; color: #666; text-transform: uppercase; font-weight: 700; border-bottom: 1px solid rgba(255,255,255,0.05);">Kết quả tìm kiếm</div>';
                                    data.forEach(movie => {
                                        const mainGenre = movie.genre ? movie.genre.split('/')[0] : '';
                                        html += `
                                            <a href="/Product/Detail/${movie.id}" style="display: flex; align-items: center; gap: 15px; padding: 12px 15px; border-bottom: 1px solid rgba(255,255,255,0.05); text-decoration: none; transition: background 0.2s;" onmouseover="this.style.background='rgba(255,255,255,0.1)'" onmouseout="this.style.background='transparent'">
                                                <img src="${movie.imageUrl}" alt="${movie.title}" style="width: 50px; height: 70px; object-fit: cover; border-radius: 4px; box-shadow: 0 4px 8px rgba(0,0,0,0.4);" />
                                                <div style="flex: 1; overflow: hidden;">
                                                    <div style="font-weight: 700; color: #fff; font-size: 1rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-bottom: 5px;">${movie.title}</div>
                                                    <div style="font-size: 0.8rem; color: #aaa; display: flex; align-items: center; gap: 10px;">
                                                        <span style="color: #e50914; font-weight: 700; background: rgba(229,9,20,0.1); padding: 2px 6px; border-radius: 3px;">${mainGenre}</span>
                                                        <span>${movie.year}</span>
                                                    </div>
                                                </div>
                                            </a>
                                        `;
                                    });
                                    searchResults.innerHTML = html;
                                }
                                searchResults.style.display = 'block';
                            })
                            .catch(err => console.error("Search API error:", err));
                    }, 250); // 250ms debounce
                });

                // Close dropdown when clicking outside
                document.addEventListener('click', function(e) {
                    if (!searchInput.contains(e.target) && !searchResults.contains(e.target)) {
                        searchResults.style.display = 'none';
                    }
                });

                // Re-open on focus
                searchInput.addEventListener('focus', function() {
                    if (this.value.trim().length > 0 && searchResults.innerHTML.trim() !== '') {
                        searchResults.style.display = 'block';
                    }
                });
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
