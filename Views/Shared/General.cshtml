@{
    ViewData["Title"] = "Lỗi - FILMIX";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .error-page {
        min-height: 100vh;
        background: #141414;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 80px 20px;
        font-family: 'Outfit', sans-serif;
        position: relative;
        overflow: hidden;
    }

    .error-bg {
        position: absolute;
        inset: 0;
        background:
            radial-gradient(ellipse at 30% 50%, rgba(229,9,20,0.06) 0%, transparent 60%),
            radial-gradient(ellipse at 70% 30%, rgba(229,9,20,0.04) 0%, transparent 50%);
        animation: bgPulse 7s ease-in-out infinite alternate;
    }

    @@keyframes bgPulse {
        from { opacity: 0.6; }
        to   { opacity: 1; }
    }

    .error-content {
        position: relative;
        z-index: 2;
        text-align: center;
        max-width: 600px;
    }

    .error-icon {
        font-size: 5rem;
        margin-bottom: 20px;
        animation: iconBounce 2s ease-in-out infinite;
    }

    @@keyframes iconBounce {
        0%, 100% { transform: translateY(0); }
        50%       { transform: translateY(-12px); }
    }

    .error-code {
        font-size: clamp(4rem, 14vw, 8rem);
        font-weight: 900;
        color: #e50914;
        line-height: 1;
        margin-bottom: 8px;
        text-shadow: 0 0 40px rgba(229,9,20,0.4);
    }

    .error-divider {
        width: 50px;
        height: 3px;
        background: #e50914;
        margin: 0 auto 20px;
        border-radius: 2px;
    }

    .error-title {
        font-size: clamp(1.2rem, 3vw, 1.6rem);
        font-weight: 700;
        color: #fff;
        margin-bottom: 14px;
    }

    .error-desc {
        font-size: 1rem;
        color: #aaa;
        line-height: 1.6;
        margin-bottom: 36px;
    }

    .error-actions {
        display: flex;
        gap: 14px;
        justify-content: center;
        flex-wrap: wrap;
    }

    .error-btn {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        padding: 12px 26px;
        font-size: 0.95rem;
        font-weight: 700;
        border-radius: 6px;
        text-decoration: none;
        transition: all 0.25s ease;
        cursor: pointer;
        border: none;
        font-family: inherit;
    }

    .error-btn--red {
        background: #e50914;
        color: #fff;
    }
    .error-btn--red:hover {
        background: #f40612;
        transform: scale(1.04);
        box-shadow: 0 8px 24px rgba(229,9,20,0.4);
    }

    .error-btn--ghost {
        background: rgba(255,255,255,0.1);
        color: #fff;
        border: 1px solid rgba(255,255,255,0.2);
    }
    .error-btn--ghost:hover {
        background: rgba(255,255,255,0.2);
        transform: scale(1.04);
    }
</style>

<div class="error-page">
    <div class="error-bg"></div>

    <div class="error-content">
        <div class="error-icon" aria-hidden="true">⚠️</div>

        <div class="error-code">500</div>
        <div class="error-divider"></div>

        <h1 class="error-title">Đã có lỗi xảy ra</h1>
        <p class="error-desc">
            Máy chủ gặp sự cố khi xử lý yêu cầu của bạn.<br>
            Vui lòng thử lại sau hoặc quay về trang chủ.
        </p>

        <div class="error-actions">
            <a href="/" class="error-btn error-btn--red">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/>
                </svg>
                Về Trang Chủ
            </a>
            <button onclick="location.reload()" class="error-btn error-btn--ghost">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M17.65 6.35A7.958 7.958 0 0012 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0112 18c-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"/>
                </svg>
                Thử Lại
            </button>
            <button onclick="history.back()" class="error-btn error-btn--ghost">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/>
                </svg>
                Quay Lại
            </button>
        </div>
    </div>
</div>
