## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
build/
bld/
[Bb]in/
[Oo]bj/
out/
[Tt]est[Rr]esults/
[Tt]est[Rr]esult/

# Visual Studio 2015/2017 cache/options directory
.vs/
# Uncomment if you have tasks that create the project's static files in wwwroot
#wwwroot/lib/

# Visual Studio Code config
.vscode/

# Node.js
node_modules/

# OS generated files
.DS_Store
Thumbs.db

# User settings files (optional: keep if you want to share, ignore if private)
appsettings.Development.json

# Logs
*.log
