@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — FILMIX Admin</title>
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="admin-body">
@{
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var userName = User.Identity?.Name ?? "";
    var avatar   = userName.Length > 0 ? char.ToUpper(userName[0]).ToString() : "A";
}
<div class="admin-shell">

    <!-- ── Sidebar ── -->
    <aside class="admin-sidebar">
        <div class="sidebar-logo">
            <a asp-area="" asp-controller="Home" asp-action="Index">FILM<span>IX</span></a>
            <span class="sidebar-badge">Admin</span>
        </div>

        <nav class="sidebar-nav">
            <div class="sidebar-section">Menu</div>

            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"
               class="sidebar-link @(ctrl == "Dashboard" ? "active" : "")">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z"/>
                </svg>
                Dashboard
            </a>

            <a asp-area="Admin" asp-controller="Product" asp-action="Index"
               class="sidebar-link @(ctrl == "Product" ? "active" : "")">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M18 4l2 4h-3l-2-4h-2l2 4h-3l-2-4H8l2 4H7L5 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V4h-4z"/>
                </svg>
                Quản Lý Phim
            </a>

            <a asp-area="Admin" asp-controller="Category" asp-action="Index"
               class="sidebar-link @(ctrl == "Category" ? "active" : "")">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M21.41 11.58l-9-9C12.05 2.22 11.55 2 11 2H4c-1.1 0-2 .9-2 2v7c0 .55.22 1.05.59 1.42l9 9c.36.36.86.58 1.41.58.55 0 1.05-.22 1.41-.59l7-7c.37-.36.59-.86.59-1.41 0-.55-.23-1.06-.59-1.42zM5.5 7C4.67 7 4 6.33 4 5.5S4.67 4 5.5 4 7 4.67 7 5.5 6.33 7 5.5 7z"/>
                </svg>
                Quản Lý Danh Mục
            </a>

            <a asp-area="Admin" asp-controller="Order" asp-action="Index"
               class="sidebar-link @(ctrl == "Order" ? "active" : "")">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"/>
                </svg>
                Quản Lý Đơn Hàng
            </a>

            <div class="sidebar-section" style="margin-top:8px">Nâng cao</div>

            <a asp-area="Admin" asp-controller="User" asp-action="Index"
               class="sidebar-link @(ctrl == "User" ? "active" : "")">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/>
                </svg>
                Quản Lý Người Dùng
            </a>

            <a asp-area="Admin" asp-controller="Subscription" asp-action="Index"
               class="sidebar-link @(ctrl == "Subscription" ? "active" : "")">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zm4.24 16L12 15.45 7.77 18l1.12-4.81-3.73-3.23 4.92-.42L12 5l1.92 4.53 4.92.42-3.73 3.23L16.23 18z"/>
                </svg>
                Gói Đăng Ký
            </a>

            <a asp-area="Admin" asp-controller="Analytics" asp-action="Index"
               class="sidebar-link @(ctrl == "Analytics" ? "active" : "")">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z"/>
                </svg>
                Phân Tích & Thống Kê
            </a>

            <a asp-area="Admin" asp-controller="SystemLog" asp-action="Index"
               class="sidebar-link @(ctrl == "SystemLog" ? "active" : "")">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 4l5 2.18V11c0 3.5-2.33 6.79-5 7.93-2.67-1.14-5-4.43-5-7.93V7.18L12 5zm-1 3v4h2V8h-2zm0 5v2h2v-2h-2z"/>
                </svg>
                System Logs
            </a>
        </nav>

        <div class="sidebar-footer">
            <div class="sidebar-user">
                <div class="sidebar-avatar">@avatar</div>
                <span class="sidebar-username">@userName</span>
            </div>
            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-logout">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5-5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z"/>
                    </svg>
                    Đăng Xuất
                </button>
            </form>
        </div>
    </aside>

    <!-- ── Main ── -->
    <div class="admin-main">
        <header class="admin-topbar">
            <div class="topbar-title">@(ViewData["Title"] ?? "Admin")</div>
            <div class="topbar-right">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="topbar-link">← Về trang chủ</a>
                <span class="topbar-user">@userName</span>
            </div>
        </header>

        <main class="admin-content">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                    </svg>
                    @TempData["Success"]
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/>
                    </svg>
                    @TempData["Error"]
                </div>
            }

            @RenderBody()
        </main>
    </div>

</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
