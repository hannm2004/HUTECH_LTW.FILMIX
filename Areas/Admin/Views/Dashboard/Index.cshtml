@model untitled1.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "_AdminLayout";
}

@* ── KPI Cards ── *@
<div class="kpi-grid">
    <div class="kpi-card kpi-red">
        <div class="kpi-icon">🎬</div>
        <div class="kpi-body">
            <div class="kpi-value">@Model.TotalMovies</div>
            <div class="kpi-label">Tổng Phim</div>
            <div class="kpi-sub">@Model.TotalFilms phim lẻ · @Model.TotalTVSeries TV series</div>
        </div>
    </div>
    <div class="kpi-card kpi-blue">
        <div class="kpi-icon">👥</div>
        <div class="kpi-body">
            <div class="kpi-value">@Model.TotalUsers</div>
            <div class="kpi-label">Người Dùng</div>
            <div class="kpi-sub">
                @if (Model.UserGrowthPct > 0)
                { <span class="trend-up">↑ @Model.UserGrowthPct%</span> }
                else
                { <span class="trend-neutral">ổn định</span> }
                so tháng trước
            </div>
        </div>
    </div>
    <div class="kpi-card kpi-gold">
        <div class="kpi-icon">👑</div>
        <div class="kpi-body">
            <div class="kpi-value">@Model.ActiveSubscriptions</div>
            <div class="kpi-label">Gói Premium Đang Hoạt Động</div>
            <div class="kpi-sub">@Model.PendingOrders đơn hàng chờ xử lý</div>
        </div>
    </div>
    <div class="kpi-card kpi-green">
        <div class="kpi-icon">💰</div>
        <div class="kpi-body">
            <div class="kpi-value">@Model.MonthRevenue.ToString("N0") ₫</div>
            <div class="kpi-label">Doanh Thu Tháng Này</div>
            <div class="kpi-sub">
                @if (Model.RevenueGrowthPct >= 0)
                { <span class="trend-up">↑ @Model.RevenueGrowthPct%</span> }
                else
                { <span class="trend-down">↓ @Math.Abs(Model.RevenueGrowthPct)%</span> }
                so tháng trước
            </div>
        </div>
    </div>
</div>

@* ── Charts Row ── *@
<div class="charts-row">
    <div class="chart-card">
        <div class="chart-header">
            <h3 class="chart-title">📈 Doanh Thu 6 Tháng</h3>
        </div>
        <canvas id="revenueChart" height="120"></canvas>
    </div>
    <div class="chart-card chart-card--sm">
        <div class="chart-header">
            <h3 class="chart-title">🔔 Đăng Ký Mới / Tháng</h3>
        </div>
        <canvas id="subChart" height="120"></canvas>
    </div>
</div>

@* ── Recent Activity Row ── *@
<div class="dash-row">

    @* Recent Orders *@
    <div class="dash-panel">
        <div class="panel-header">
            <span>🛒 Đơn Hàng Gần Đây</span>
            <a asp-area="Admin" asp-controller="Order" asp-action="Index" class="panel-link">Xem tất cả →</a>
        </div>
        <table class="admin-table">
            <thead><tr><th>#</th><th>Khách hàng</th><th>Số tiền</th><th>Trạng thái</th></tr></thead>
            <tbody>
            @foreach (var o in Model.RecentOrders)
            {
                <tr>
                    <td>#@o.Id</td>
                    <td>@(o.User?.UserName ?? o.Email)</td>
                    <td class="text-right">@o.TotalAmount.ToString("N0") ₫</td>
                    <td>
                        <span class="badge badge-@o.Status.ToString().ToLower()">@o.Status</span>
                    </td>
                </tr>
            }
            @if (!Model.RecentOrders.Any())
            {
                <tr><td colspan="4" class="text-center muted">Chưa có đơn hàng nào.</td></tr>
            }
            </tbody>
        </table>
    </div>

    @* Recent Subscriptions *@
    <div class="dash-panel">
        <div class="panel-header">
            <span>👑 Gói Đăng Ký Gần Đây</span>
            <a asp-area="Admin" asp-controller="Subscription" asp-action="Index" class="panel-link">Xem tất cả →</a>
        </div>
        <table class="admin-table">
            <thead><tr><th>Người dùng</th><th>Gói</th><th>Hết hạn</th><th>Trạng thái</th></tr></thead>
            <tbody>
            @foreach (var s in Model.RecentSubscriptions)
            {
                <tr>
                    <td>@(s.User?.UserName ?? "")</td>
                    <td>@(s.Plan?.Name ?? "")</td>
                    <td>@s.EndDate.ToString("dd/MM/yyyy")</td>
                    <td>
                        @if (s.IsActive && s.EndDate >= DateTime.UtcNow)
                        { <span class="badge badge-active">Hoạt động</span> }
                        else
                        { <span class="badge badge-cancelled">Hết hạn</span> }
                    </td>
                </tr>
            }
            @if (!Model.RecentSubscriptions.Any())
            {
                <tr><td colspan="4" class="text-center muted">Chưa có gói đăng ký nào.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>

@* ── Quick Stats Bar ── *@
<div class="stats-bar">
    <div class="stat-item">
        <span class="stat-val">@Model.TotalOrders</span>
        <span class="stat-lbl">Tổng đơn hàng</span>
    </div>
    <div class="stat-divider"></div>
    <div class="stat-item">
        <span class="stat-val">@Model.TotalRevenue.ToString("N0") ₫</span>
        <span class="stat-lbl">Tổng doanh thu</span>
    </div>
    <div class="stat-divider"></div>
    <div class="stat-item">
        <span class="stat-val">@Model.PendingOrders</span>
        <span class="stat-lbl">Đơn chờ xử lý</span>
    </div>
    <div class="stat-divider"></div>
    <div class="stat-item">
        <span class="stat-val">@Model.ActiveSubscriptions</span>
        <span class="stat-lbl">Premium đang hoạt động</span>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.min.js"></script>
<script>
(function () {
    const chartDefaults = {
        responsive: true,
        plugins: { legend: { display: false } },
        scales: {
            x: { grid: { color: 'rgba(255,255,255,.07)' }, ticks: { color: '#aaa', font: { size: 11 } } },
            y: { grid: { color: 'rgba(255,255,255,.07)' }, ticks: { color: '#aaa', font: { size: 11 } } }
        }
    };

    // Revenue bar chart
    new Chart(document.getElementById('revenueChart'), {
        type: 'bar',
        data: {
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueChartLabels)),
            datasets: [{
                label: 'Doanh thu (₫)',
                data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueChartData)),
                backgroundColor: 'rgba(229,9,20,.75)',
                borderRadius: 6,
                borderSkipped: false,
            }]
        },
        options: { ...chartDefaults, plugins: { legend: { display: false }, tooltip: {
            callbacks: { label: ctx => ctx.parsed.y.toLocaleString('vi-VN') + ' ₫' }
        } } }
    });

    // Subscriptions line chart
    new Chart(document.getElementById('subChart'), {
        type: 'line',
        data: {
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.UserChartLabels)),
            datasets: [{
                label: 'Đăng ký mới',
                data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.UserChartData)),
                borderColor: '#f59e0b',
                backgroundColor: 'rgba(245,158,11,.15)',
                borderWidth: 2,
                fill: true,
                tension: 0.4,
                pointBackgroundColor: '#f59e0b',
            }]
        },
        options: chartDefaults
    });
})();
</script>
}
