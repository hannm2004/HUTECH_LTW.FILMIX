@model untitled1.Models.Entities.SystemLog
@{
    ViewData["Title"] = $"Log #{Model.Id}";
    Layout = "_AdminLayout";

    var (badgeClass, icon) = Model.Action switch
    {
        "Login"                   => ("badge-active",  "🔑"),
        "Login Failed"            => ("badge-danger",  "🚫"),
        "Logout"                  => ("badge-neutral", "🚪"),
        "Register"                => ("badge-info",    "📝"),
        "Register Failed"         => ("badge-danger",  "❌"),
        "Add Movie"               => ("badge-info",    "🎬"),
        "Edit Movie"              => ("badge-warning", "✏️"),
        "Delete Movie"            => ("badge-danger",  "🗑️"),
        "Buy Premium"             => ("badge-gold",    "👑"),
        "Grant Admin"             => ("badge-admin",   "🛡️"),
        "Revoke Admin"            => ("badge-danger",  "🔓"),
        "Grant Premium"           => ("badge-gold",    "⭐"),
        "Revoke Premium"          => ("badge-warning", "⚠️"),
        "Deactivate Subscription" => ("badge-warning", "🚫"),
        _                         => ("badge-neutral", "📋")
    };
}

<div style="max-width: 760px; margin: 0 auto;">

    @* ── Header card ── *@
    <div class="chart-card" style="margin-bottom: 24px; padding: 28px 32px;">
        <div style="display: flex; align-items: flex-start; gap: 20px;">
            <div style="font-size: 2.6rem; line-height:1;">@icon</div>
            <div style="flex: 1;">
                <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 8px;">
                    <span class="badge @badgeClass" style="font-size: 0.85rem; padding: 5px 14px;">@Model.Action</span>
                    <span class="muted" style="font-size: 0.82rem;">Log #@Model.Id</span>
                </div>
                <div style="font-size: 1.05rem; color: #eee; font-weight: 600; line-height: 1.5;">
                    @Model.Description
                </div>
            </div>
        </div>
    </div>

    @* ── Detail grid ── *@
    <div class="chart-card" style="padding: 28px 32px;">
        <h3 class="chart-title" style="margin-bottom: 20px;">📋 Thông Tin Chi Tiết</h3>

        <dl style="display: grid; grid-template-columns: 160px 1fr; gap: 0; margin: 0;">
            @{
                void Row(string label, string? value, string? extraStyle = null)
                {
                    <dt style="padding: 13px 0; border-bottom: 1px solid rgba(255,255,255,0.06); color: #888; font-size: 0.85rem; font-weight: 600; align-self: center;">@label</dt>
                    <dd style="padding: 13px 0 13px 20px; border-bottom: 1px solid rgba(255,255,255,0.06); color: #ddd; font-size: 0.88rem; margin: 0; @extraStyle word-break: break-word;">
                        @(string.IsNullOrEmpty(value) ? "—" : value)
                    </dd>
                }
            }

            @{ Row("ID", Model.Id.ToString()); }
            @{ Row("Hành động", Model.Action); }
            @{ Row("Thời gian", Model.CreatedAt.ToString("HH:mm:ss — dd/MM/yyyy")); }
            @{ Row("Người dùng", Model.UserName); }
            @{ Row("User ID", Model.UserId, "font-family: monospace; font-size: 0.78rem; color: #999;"); }
            @{ Row("IP Address", Model.IpAddress, "font-family: monospace;"); }

            <dt style="padding: 13px 0; color: #888; font-size: 0.85rem; font-weight: 600;">Mô tả</dt>
            <dd style="padding: 13px 0 13px 20px; color: #ddd; font-size: 0.88rem; margin: 0; line-height: 1.6;">
                @Model.Description
            </dd>
        </dl>
    </div>

    @* ── Back button ── *@
    <div style="margin-top: 20px; display: flex; gap: 12px;">
        <a asp-area="Admin" asp-controller="SystemLog" asp-action="Index"
           class="btn-sm btn-outline" style="padding: 9px 20px;">
            ← Quay lại danh sách
        </a>
        @if (!string.IsNullOrEmpty(Model.UserId))
        {
            <a asp-area="Admin" asp-controller="User" asp-action="Detail"
               asp-route-id="@Model.UserId"
               class="btn-sm btn-outline" style="padding: 9px 20px;">
                👤 Xem hồ sơ người dùng
            </a>
        }
    </div>
</div>
