@model Movie
@{
    ViewData["Title"] = "Sửa Phim";
    var categories = ViewBag.Categories as List<Category> ?? new List<Category>();
    var selected   = ViewBag.SelectedCategories as List<int> ?? new List<int>();
}

<div class="page-header">
    <h1>Sửa <span>Phim</span></h1>
</div>

<div class="form-card">
    <form asp-area="Admin" asp-controller="Product" asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" id="removeAllImages" name="removeAllImages" value="false" />

        <div class="form-row-2col">
            <div class="form-row">
                <label asp-for="Title">Tiêu Đề</label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div class="form-row">
                <label asp-for="Year">Năm Phát Hành</label>
                <input asp-for="Year" type="number" class="form-control" min="1900" max="2100" />
                <span asp-validation-for="Year" class="text-danger"></span>
            </div>
        </div>

        <div class="form-row">
            <label for="posterFile">Tải Ảnh Bìa Lên (jpg, jpeg, png, webp - Tối đa 5MB)</label>
            <input type="file" id="posterFile" name="posterFile" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
            <span id="fileError" class="text-danger" style="display:none;"></span>
        </div>

        <div class="form-row">
            <label asp-for="ImageUrl">Hoặc Nhập URL Ảnh Bìa (nếu không tải file lên)</label>
            <input asp-for="ImageUrl" class="form-control" />
            <span asp-validation-for="ImageUrl" class="text-danger"></span>
        </div>

        <div id="previewContainer" style="margin-bottom:17px;">
            <label style="display:block; font-size:.72rem; font-weight:700; color:rgba(255,255,255,.4); letter-spacing:.5px; text-transform:uppercase; margin-bottom:6px;">Xem Trước Ảnh Bìa Hiện Tại</label>
            <div style="display:flex; align-items:flex-start; gap:14px;">
                <img id="posterPreview" src="@Model.ImageUrl" alt="Current Poster"
                     onerror="this.src='/images/posters/default.jpg'"
                     style="width:110px; height:155px; object-fit:cover; border-radius:7px; border:1px solid rgba(255,255,255,.12); background:rgba(255,255,255,.04);" />
                <div style="display:flex; flex-direction:column; gap:6px; padding-top:4px;">
                    <span id="previewFileName" style="font-size:.78rem; color:rgba(255,255,255,.65);">@Model.ImageUrl</span>
                    <span id="previewFileSize" style="font-size:.72rem; color:rgba(255,255,255,.35);"></span>
                    <button type="button" id="clearFile" style="margin-top:6px; background:rgba(229,9,20,.1); border:1px solid rgba(229,9,20,.25); color:#ff6b6b; border-radius:5px; padding:4px 10px; font-size:.74rem; cursor:pointer;">✕ Xóa tất cả ảnh của phim</button>
                </div>
            </div>
        </div>

        <div class="form-row-2col">
            <div class="form-row">
                <label asp-for="Genre">Thể Loại (mô tả)</label>
                <input asp-for="Genre" class="form-control" />
            </div>
            <div class="form-row">
                <label asp-for="Director">Đạo Diễn</label>
                <input asp-for="Director" class="form-control" />
            </div>
        </div>

        <div class="form-row">
            <label asp-for="Cast">Diễn Viên</label>
            <input asp-for="Cast" class="form-control" />
        </div>

        <div class="form-row">
            <label asp-for="Description">Mô Tả / Nội Dung Phim</label>
            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
        </div>

        <div class="form-row">
            <label asp-for="TrailerUrl">
                URL Trailer
                <small style="color:#8892a4; font-weight:400; margin-left:6px;">(YouTube embed, VD: https://www.youtube.com/embed/XXXX)</small>
            </label>
            <input asp-for="TrailerUrl" class="form-control" />
        </div>

        <div class="form-row">
            <label asp-for="VideoUrl">
                Đường Dẫn Video Phim (Xem Ngay)
                <small style="color:#8892a4; font-weight:400; margin-left:6px;">(File cục bộ, VD: /videos/movies/breaking_bad.mp4)</small>
            </label>
            <input asp-for="VideoUrl" class="form-control" placeholder="/videos/movies/ten_phim.mp4" />
        </div>

        <div class="form-row">
            <label asp-for="TrailerVideoUrl">
                Đường Dẫn Teaser Cục Bộ
                <small style="color:#8892a4; font-weight:400; margin-left:6px;">(File MP4, VD: /videos/trailers/breaking_bad.mp4 — để trống sẽ dùng URL Trailer YouTube)</small>
            </label>
            <input asp-for="TrailerVideoUrl" class="form-control" placeholder="/videos/trailers/ten_phim.mp4" />
        </div>

        <div class="check-row">
            <input asp-for="IsTVSeries" type="checkbox" id="IsTVSeries" />
            <label for="IsTVSeries">Là TV Series (có nhiều tập)</label>
        </div>

        <div class="form-row">
            <label>Danh Mục</label>
            <div class="cat-check-grid">
                @foreach (var cat in categories)
                {
                    <label class="cat-check-item">
                        <input type="checkbox" name="selectedCategories" value="@cat.Id"
                               @(selected.Contains(cat.Id) ? "checked" : "") />
                        <span>@cat.Name</span>
                    </label>
                }
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-submit">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V7l-4-4zm-5 16c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm3-10H5V5h10v4z"/></svg>
                Cập Nhật
            </button>
            <a asp-area="Admin" asp-controller="Product" asp-action="Index" class="btn-cancel">Hủy</a>
        </div>
    </form>
</div>

@section Scripts {
    <style>
        .form-row-2col {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0 20px;
        }
        .form-row-2col .form-row { margin-bottom: 0; }
        @@media (max-width: 600px) { .form-row-2col { grid-template-columns: 1fr; } }
        textarea.form-control { resize: vertical; min-height: 100px; font-family: inherit; }
    </style>
    <script>
        (function () {
            const fileInput   = document.getElementById('posterFile');
            const urlInput    = document.getElementById('ImageUrl');
            const removeFlag  = document.getElementById('removeAllImages');
            const preview     = document.getElementById('posterPreview');
            const fileName    = document.getElementById('previewFileName');
            const fileSize    = document.getElementById('previewFileSize');
            const clearBtn    = document.getElementById('clearFile');
            const fileError   = document.getElementById('fileError');
            const DEFAULT_SRC = '@Model.ImageUrl';
            const PLACEHOLDER = '/images/posters/default.jpg';
            const ALLOWED_EXT = ['.jpg', '.jpeg', '.png', '.webp'];
            const MAX_SIZE    = 5 * 1024 * 1024;

            fileInput.addEventListener('change', function () {
                fileError.style.display = 'none';
                removeFlag.value = 'false'; // chọn ảnh mới -> hủy ý định xóa hết ảnh
                const file = this.files[0];
                if (!file) { restoreDefault(); return; }
                const ext = file.name.slice(file.name.lastIndexOf('.')).toLowerCase();
                if (!ALLOWED_EXT.includes(ext)) {
                    fileError.textContent = 'File không hợp lệ. Chỉ chấp nhận .jpg .jpeg .png .webp';
                    fileError.style.display = 'block';
                    this.value = ''; restoreDefault(); return;
                }
                if (file.size > MAX_SIZE) {
                    fileError.textContent = 'File vượt quá giới hạn 5 MB.';
                    fileError.style.display = 'block';
                    this.value = ''; restoreDefault(); return;
                }
                const reader = new FileReader();
                reader.onload = e => {
                    preview.src = e.target.result;
                    fileName.textContent = file.name;
                    fileSize.textContent = (file.size / 1024).toFixed(1) + ' KB';
                };
                reader.readAsDataURL(file);
                urlInput.value = '';
            });

            urlInput.addEventListener('input', function () {
                if (fileInput.files.length > 0) return;
                removeFlag.value = 'false'; // nhập URL -> hủy ý định xóa hết ảnh
                const url = this.value.trim();
                preview.src     = url || DEFAULT_SRC;
                fileName.textContent = url || DEFAULT_SRC;
                fileSize.textContent = '';
            });

            // Nút này XÓA HẾT ẢNH của phim (poster + ảnh phụ) khi bấm "Cập Nhật".
            clearBtn.addEventListener('click', function () {
                removeFlag.value = 'true';
                fileInput.value = '';
                urlInput.value  = '';
                fileError.style.display = 'none';
                preview.src          = PLACEHOLDER;
                fileName.textContent = '⚠ Tất cả ảnh sẽ bị xóa khi bấm "Cập Nhật"';
                fileSize.textContent = '';
            });

            function restoreDefault() {
                preview.src          = DEFAULT_SRC || PLACEHOLDER;
                fileName.textContent = DEFAULT_SRC;
                fileSize.textContent = '';
            }
        })();
    </script>
}
