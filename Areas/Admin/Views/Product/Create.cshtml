    @model Movie
    @{
        ViewData["Title"] = "Thêm Phim Mới";
        var categories = ViewBag.Categories as List<Category> ?? new List<Category>();
    }

    <div class="page-header">
        <h1>Thêm <span>Phim Mới</span></h1>
    </div>

    <div class="form-card">
        <form asp-area="Admin" asp-controller="Product" asp-action="Create" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div class="form-row-2col">
                <div class="form-row">
                    <label asp-for="Title">Tiêu Đề</label>
                    <input asp-for="Title" class="form-control" placeholder="Nhập tiêu đề phim..." />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>
                <div class="form-row">
                    <label asp-for="Year">Năm Phát Hành</label>
                    <input asp-for="Year" type="number" class="form-control" placeholder="2024" min="1900" max="2100" />
                    <span asp-validation-for="Year" class="text-danger"></span>
                </div>
            </div>

            <div class="form-row">
                <label for="posterFile">Tải Ảnh Bìa Lên (jpg, jpeg, png, webp - Tối đa 5MB)</label>
                <input type="file" id="posterFile" name="posterFile" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                <span id="fileError" class="text-danger" style="display:none;"></span>
            </div>

            <div class="form-row">
                <label asp-for="ImageUrl">Hoặc Nhập URL Ảnh Bìa (nếu không tải file lên)</label>
                <input asp-for="ImageUrl" class="form-control" placeholder="/images/movies/ten-anh.jpg" />
                <span asp-validation-for="ImageUrl" class="text-danger"></span>
            </div>

            <div id="previewContainer" style="display:none; margin-bottom:17px;">
                <label style="display:block; font-size:.72rem; font-weight:700; color:rgba(255,255,255,.4); letter-spacing:.5px; text-transform:uppercase; margin-bottom:6px;">Xem Trước Ảnh Bìa</label>
                <div style="display:flex; align-items:flex-start; gap:14px;">
                    <img id="posterPreview" src="" alt="Preview" style="width:110px; height:155px; object-fit:cover; border-radius:7px; border:1px solid rgba(255,255,255,.12); background:rgba(255,255,255,.04);" />
                    <div style="display:flex; flex-direction:column; gap:6px; padding-top:4px;">
                        <span id="previewFileName" style="font-size:.78rem; color:rgba(255,255,255,.65);"></span>
                        <span id="previewFileSize" style="font-size:.72rem; color:rgba(255,255,255,.35);"></span>
                        <button type="button" id="clearFile" style="margin-top:6px; background:rgba(229,9,20,.1); border:1px solid rgba(229,9,20,.25); color:#ff6b6b; border-radius:5px; padding:4px 10px; font-size:.74rem; cursor:pointer;">✕ Xóa ảnh</button>
                    </div>
                </div>
            </div>

            <div class="form-row-2col">
                <div class="form-row">
                    <label asp-for="Genre">Thể Loại (mô tả)</label>
                    <input asp-for="Genre" class="form-control" placeholder="Action / Drama" />
                    <span asp-validation-for="Genre" class="text-danger"></span>
                </div>
                <div class="form-row">
                    <label asp-for="Director">Đạo Diễn</label>
                    <input asp-for="Director" class="form-control" placeholder="Christopher Nolan" />
                </div>
            </div>

            <div class="form-row">
                <label asp-for="Cast">Diễn Viên</label>
                <input asp-for="Cast" class="form-control" placeholder="Robert Downey Jr., Scarlett Johansson..." />
            </div>

            <div class="form-row">
                <label asp-for="Description">Mô Tả / Nội Dung Phim</label>
                <textarea asp-for="Description" class="form-control" rows="4"
                        placeholder="Tóm tắt nội dung phim, không quá 500 ký tự..."></textarea>
            </div>

            <div class="form-row">
                <label asp-for="TrailerUrl">
                    URL Trailer
                    <small style="color:#8892a4; font-weight:400; margin-left:6px;">(YouTube embed, VD: https://www.youtube.com/embed/XXXX)</small>
                </label>
                <input asp-for="TrailerUrl" class="form-control" placeholder="https://www.youtube.com/embed/..." />
            </div>

            <div class="form-row">
                <label asp-for="VideoUrl">
                    Đường Dẫn Video Phim (Xem Ngay)
                    <small style="color:#8892a4; font-weight:400; margin-left:6px;">(File cục bộ, VD: /videos/movies/ten_phim.mp4)</small>
                </label>
                <input asp-for="VideoUrl" class="form-control" placeholder="/videos/movies/ten_phim.mp4" />
            </div>

            <div class="form-row">
                <label asp-for="TrailerVideoUrl">
                    Đường Dẫn Teaser Cục Bộ
                    <small style="color:#8892a4; font-weight:400; margin-left:6px;">(File MP4, VD: /videos/trailers/ten_phim.mp4)</small>
                </label>
                <input asp-for="TrailerVideoUrl" class="form-control" placeholder="/videos/trailers/ten_phim.mp4" />
            </div>

            <div class="check-row">
                <input asp-for="IsTVSeries" type="checkbox" id="IsTVSeries" />
                <label for="IsTVSeries">Là TV Series (có nhiều tập)</label>
            </div>

            <div class="form-row">
                <label>Danh Mục</label>
                <div class="cat-check-grid">
                    @foreach (var cat in categories)
                    {
                        <label class="cat-check-item">
                            <input type="checkbox" name="selectedCategories" value="@cat.Id" />
                            <span>@cat.Name</span>
                        </label>
                    }
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-submit">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V7l-4-4zm-5 16c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm3-10H5V5h10v4z"/></svg>
                    Lưu Phim
                </button>
                <a asp-area="Admin" asp-controller="Product" asp-action="Index" class="btn-cancel">Hủy</a>
            </div>
        </form>
    </div>

    @section Scripts {
        <style>
            .form-row-2col {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 0 20px;
            }
            .form-row-2col .form-row { margin-bottom: 0; }
            @@media (max-width: 600px) { .form-row-2col { grid-template-columns: 1fr; } }
            textarea.form-control { resize: vertical; min-height: 100px; font-family: inherit; }
        </style>
        <script>
            (function () {
                const fileInput    = document.getElementById('posterFile');
                const urlInput     = document.getElementById('ImageUrl');
                const preview      = document.getElementById('posterPreview');
                const container    = document.getElementById('previewContainer');
                const fileName     = document.getElementById('previewFileName');
                const fileSize     = document.getElementById('previewFileSize');
                const clearBtn     = document.getElementById('clearFile');
                const fileError    = document.getElementById('fileError');
                const ALLOWED_EXT  = ['.jpg', '.jpeg', '.png', '.webp'];
                const MAX_SIZE     = 5 * 1024 * 1024;

                function showPreview(src, name, size) {
                    preview.src    = src;
                    container.style.display = 'block';
                    fileName.textContent   = name || '';
                    fileSize.textContent   = size ? (size / 1024).toFixed(1) + ' KB' : '';
                }
                function hidePreview() {
                    container.style.display = 'none';
                    preview.src = '';
                }

                fileInput.addEventListener('change', function () {
                    fileError.style.display = 'none';
                    const file = this.files[0];
                    if (!file) { hidePreview(); return; }
                    const ext = file.name.slice(file.name.lastIndexOf('.')).toLowerCase();
                    if (!ALLOWED_EXT.includes(ext)) {
                        fileError.textContent = 'File không hợp lệ. Chỉ chấp nhận .jpg .jpeg .png .webp';
                        fileError.style.display = 'block';
                        this.value = ''; hidePreview(); return;
                    }
                    if (file.size > MAX_SIZE) {
                        fileError.textContent = 'File vượt quá giới hạn 5 MB.';
                        fileError.style.display = 'block';
                        this.value = ''; hidePreview(); return;
                    }
                    const reader = new FileReader();
                    reader.onload = e => showPreview(e.target.result, file.name, file.size);
                    reader.readAsDataURL(file);
                    urlInput.value = ''; // clear URL field when file is selected
                });

                urlInput.addEventListener('input', function () {
                    if (fileInput.files.length > 0) return; // file takes priority
                    const url = this.value.trim();
                    if (url) showPreview(url, url, 0);
                    else hidePreview();
                });

                clearBtn.addEventListener('click', function () {
                    fileInput.value = '';
                    fileError.style.display = 'none';
                    hidePreview();
                });
            })();
        </script>
    }
