@model Movie
@{
    ViewData["Title"] = "Thêm Phim Mới";
    var categories = ViewBag.Categories as List<Category> ?? new List<Category>();
}

<div class="page-header">
    <h1>Thêm <span>Phim Mới</span></h1>
</div>

<div class="form-card">
    <form asp-area="Admin" asp-controller="Product" asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div class="form-row-2col">
            <div class="form-row">
                <label asp-for="Title">Tiêu Đề</label>
                <input asp-for="Title" class="form-control" placeholder="Nhập tiêu đề phim..." />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div class="form-row">
                <label asp-for="Year">Năm Phát Hành</label>
                <input asp-for="Year" type="number" class="form-control" placeholder="2024" min="1900" max="2100" />
                <span asp-validation-for="Year" class="text-danger"></span>
            </div>
        </div>

        <div class="form-row">
            <label asp-for="ImageUrl">URL Ảnh Bìa</label>
            <input asp-for="ImageUrl" class="form-control" placeholder="/images/movies/ten-anh.jpg" />
            <span asp-validation-for="ImageUrl" class="text-danger"></span>
        </div>

        <div class="form-row-2col">
            <div class="form-row">
                <label asp-for="Genre">Thể Loại (mô tả)</label>
                <input asp-for="Genre" class="form-control" placeholder="Action / Drama" />
                <span asp-validation-for="Genre" class="text-danger"></span>
            </div>
            <div class="form-row">
                <label asp-for="Director">Đạo Diễn</label>
                <input asp-for="Director" class="form-control" placeholder="Christopher Nolan" />
            </div>
        </div>

        <div class="form-row">
            <label asp-for="Cast">Diễn Viên</label>
            <input asp-for="Cast" class="form-control" placeholder="Robert Downey Jr., Scarlett Johansson..." />
        </div>

        <div class="form-row">
            <label asp-for="Description">Mô Tả / Nội Dung Phim</label>
            <textarea asp-for="Description" class="form-control" rows="4"
                      placeholder="Tóm tắt nội dung phim, không quá 500 ký tự..."></textarea>
        </div>

        <div class="form-row">
            <label asp-for="TrailerUrl">
                URL Trailer
                <small style="color:#8892a4; font-weight:400; margin-left:6px;">(YouTube embed, VD: https://www.youtube.com/embed/XXXX)</small>
            </label>
            <input asp-for="TrailerUrl" class="form-control" placeholder="https://www.youtube.com/embed/..." />
        </div>

        <div class="check-row">
            <input asp-for="IsTVSeries" type="checkbox" id="IsTVSeries" />
            <label for="IsTVSeries">Là TV Series (có nhiều tập)</label>
        </div>

        <div class="form-row">
            <label>Danh Mục</label>
            <div class="cat-check-grid">
                @foreach (var cat in categories)
                {
                    <label class="cat-check-item">
                        <input type="checkbox" name="selectedCategories" value="@cat.Id" />
                        <span>@cat.Name</span>
                    </label>
                }
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-submit">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V7l-4-4zm-5 16c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm3-10H5V5h10v4z"/></svg>
                Lưu Phim
            </button>
            <a asp-area="Admin" asp-controller="Product" asp-action="Index" class="btn-cancel">Hủy</a>
        </div>
    </form>
</div>

@section Scripts {
    <style>
        .form-row-2col {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0 20px;
        }
        .form-row-2col .form-row { margin-bottom: 0; }
        @@media (max-width: 600px) { .form-row-2col { grid-template-columns: 1fr; } }
        textarea.form-control { resize: vertical; min-height: 100px; font-family: inherit; }
    </style>
    <script>
        document.querySelector('form').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const submitBtn = this.querySelector('.btn-submit');
            const originalText = submitBtn.innerHTML;
            submitBtn.disabled = true;
            submitBtn.innerHTML = 'Đang xử lý...';
            
            const categoryIds = [];
            document.querySelectorAll('input[name="selectedCategories"]:checked').forEach(cb => {
                categoryIds.push(parseInt(cb.value));
            });
            
            const payload = {
                title: document.getElementById('Title').value,
                year: parseInt(document.getElementById('Year').value),
                imageUrl: document.getElementById('ImageUrl').value,
                genre: document.getElementById('Genre').value,
                director: document.getElementById('Director').value,
                cast: document.getElementById('Cast').value,
                description: document.getElementById('Description').value,
                trailerUrl: document.getElementById('TrailerUrl').value,
                isTVSeries: document.getElementById('IsTVSeries').checked,
                categoryIds: categoryIds
            };
            
            try {
                const response = await fetch('/api/products', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(payload)
                });
                
                const result = await response.json();
                if (response.ok && result.success) {
                    alert(result.message || 'Thêm phim mới thành công!');
                    window.location.href = '/Admin/Product';
                } else {
                    let errMsg = result.message || 'Đã có lỗi xảy ra.';
                    if (result.errors) {
                        const errorsList = [];
                        for (const key in result.errors) {
                            if (result.errors.hasOwnProperty(key)) {
                                errorsList.push(result.errors[key].join('\n'));
                            }
                        }
                        errMsg += '\n' + errorsList.join('\n');
                    }
                    alert(errMsg);
                }
            } catch (err) {
                console.error(err);
                alert('Không thể kết nối đến máy chủ.');
            } finally {
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalText;
            }
        });
    </script>
}
