@model untitled1.Models.ViewModels.AnalyticsViewModel
@{
    ViewData["Title"] = "Phân Tích & Thống Kê";
    Layout = "_AdminLayout";
}

@* ── KPI Strip ── *@
<div class="kpi-grid kpi-grid--analytics">
    <div class="kpi-card kpi-green">
        <div class="kpi-icon">💰</div>
        <div class="kpi-body">
            <div class="kpi-value">@Model.TotalRevenue.ToString("N0") ₫</div>
            <div class="kpi-label">Tổng Doanh Thu</div>
        </div>
    </div>
    <div class="kpi-card kpi-blue">
        <div class="kpi-icon">🛒</div>
        <div class="kpi-body">
            <div class="kpi-value">@Model.TotalOrders</div>
            <div class="kpi-label">Tổng Đơn Hàng</div>
        </div>
    </div>
    <div class="kpi-card kpi-gold">
        <div class="kpi-icon">👑</div>
        <div class="kpi-body">
            <div class="kpi-value">@Model.TotalActiveSubscriptions</div>
            <div class="kpi-label">Sub Đang Hoạt Động</div>
        </div>
    </div>
    <div class="kpi-card kpi-purple">
        <div class="kpi-icon">📊</div>
        <div class="kpi-body">
            <div class="kpi-value">@Model.SubscriptionConversionRate%</div>
            <div class="kpi-label">Tỉ Lệ Chuyển Đổi Premium</div>
        </div>
    </div>
</div>

@* ── Revenue & Orders Line Chart (full-width) ── *@
<div class="chart-card chart-card--full">
    <div class="chart-header">
        <h3 class="chart-title">📈 Doanh Thu & Đơn Hàng 12 Tháng Gần Nhất</h3>
        <div class="chart-legend">
            <span class="legend-dot" style="background:#e50914"></span> Doanh thu (₫)
            <span class="legend-dot" style="background:#3b82f6; margin-left:12px"></span> Đơn hàng
        </div>
    </div>
    <canvas id="revenueLineChart" height="80"></canvas>
</div>

@* ── Two charts: Plan Distribution + Payment Methods ── *@
<div class="charts-row charts-row--equal">
    <div class="chart-card">
        <div class="chart-header">
            <h3 class="chart-title">🍩 Phân Phối Gói Đăng Ký</h3>
        </div>
        <div class="doughnut-wrap">
            <canvas id="planChart"></canvas>
        </div>
        @if (Model.PlanLabels.Any())
        {
            <div class="chart-legend-list">
                @for (int i = 0; i < Model.PlanLabels.Count; i++)
                {
                    <div class="legend-row">
                        <span class="legend-swatch legend-swatch-@i"></span>
                        <span>@Model.PlanLabels[i]</span>
                        <span class="legend-count">@Model.PlanCounts[i] gói</span>
                        <span class="legend-rev">@Model.PlanRevenues[i].ToString("N0") ₫</span>
                    </div>
                }
            </div>
        }
    </div>

    <div class="chart-card">
        <div class="chart-header">
            <h3 class="chart-title">💳 Phương Thức Thanh Toán</h3>
        </div>
        <canvas id="paymentChart" height="200"></canvas>
    </div>
</div>

@* ── Subscriptions Trend ── *@
<div class="chart-card chart-card--full">
    <div class="chart-header">
        <h3 class="chart-title">📅 Đăng Ký Mới Theo Tháng</h3>
    </div>
    <canvas id="subTrendChart" height="80"></canvas>
</div>

@* ── Viewing History Analytics: Top 10 Genres & Top 10 Movies ── *@
<div class="charts-row charts-row--equal" style="margin-top: 30px;">
    <div class="chart-card">
        <div class="chart-header">
            <h3 class="chart-title">🎭 Top 10 Thể Loại Xem Nhiều Nhất</h3>
        </div>
        <div class="table-card" style="background: transparent; border: none; padding: 0; box-shadow: none;">
            @if (Model.TopGenres != null && Model.TopGenres.Any())
            {
                <table class="admin-table" style="width: 100%; border-collapse: collapse; margin-top: 10px;">
                    <thead>
                        <tr style="border-bottom: 2px solid rgba(255,255,255,0.1); text-align: left;">
                            <th style="padding: 12px 15px; color: #888; font-weight: 600; font-size: 0.9rem;">Hạng</th>
                            <th style="padding: 12px 15px; color: #888; font-weight: 600; font-size: 0.9rem;">Thể Loại</th>
                            <th style="padding: 12px 15px; color: #888; font-weight: 600; font-size: 0.9rem; text-align: right;">Lượt Xem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int genreRank = 1; }
                        @foreach (var genre in Model.TopGenres)
                        {
                            <tr style="border-bottom: 1px solid rgba(255,255,255,0.05); transition: background 0.2s;" onmouseover="this.style.background='rgba(255,255,255,0.02)'" onmouseout="this.style.background='transparent'">
                                <td style="padding: 12px 15px; font-weight: 700; color: @(genreRank <= 3 ? "#e50914" : "#ccc");">#@genreRank</td>
                                <td style="padding: 12px 15px; font-weight: 600; color: #fff;">@genre.CategoryName</td>
                                <td style="padding: 12px 15px; text-align: right; color: #46d369; font-weight: 700;">@genre.WatchCount.ToString("N0")</td>
                            </tr>
                            genreRank++;
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div style="color: #888; text-align: center; padding: 40px; font-style: italic;">
                    Chưa có lịch sử xem phim.
                </div>
            }
        </div>
    </div>

    <div class="chart-card">
        <div class="chart-header">
            <h3 class="chart-title">🎬 Top 10 Phim Xem Nhiều Nhất</h3>
        </div>
        <div class="table-card" style="background: transparent; border: none; padding: 0; box-shadow: none;">
            @if (Model.TopMovies != null && Model.TopMovies.Any())
            {
                <table class="admin-table" style="width: 100%; border-collapse: collapse; margin-top: 10px;">
                    <thead>
                        <tr style="border-bottom: 2px solid rgba(255,255,255,0.1); text-align: left;">
                            <th style="padding: 12px 15px; color: #888; font-weight: 600; font-size: 0.9rem;">Hạng</th>
                            <th style="padding: 12px 15px; color: #888; font-weight: 600; font-size: 0.9rem;">Phim</th>
                            <th style="padding: 12px 15px; color: #888; font-weight: 600; font-size: 0.9rem; text-align: right;">Lượt Xem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int movieRank = 1; }
                        @foreach (var stat in Model.TopMovies)
                        {
                            <tr style="border-bottom: 1px solid rgba(255,255,255,0.05); transition: background 0.2s;" onmouseover="this.style.background='rgba(255,255,255,0.02)'" onmouseout="this.style.background='transparent'">
                                <td style="padding: 12px 15px; font-weight: 700; color: @(movieRank <= 3 ? "#e50914" : "#ccc");">#@movieRank</td>
                                <td style="padding: 12px 15px; display: flex; align-items: center; gap: 10px;">
                                    <img src="@stat.Movie.ImageUrl" alt="@stat.Movie.Title" style="width: 40px; height: 25px; object-fit: cover; border-radius: 4px; border: 1px solid rgba(255,255,255,0.1);" onerror="this.src='/images/posters/default.jpg'" />
                                    <div style="max-width: 180px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                        <a href="/Product/Detail/@stat.Movie.Id" target="_blank" style="color: #fff; font-weight: 600; text-decoration: none; transition: color 0.2s;" onmouseover="this.style.color='#e50914'" onmouseout="this.style.color='#fff'">@stat.Movie.Title</a>
                                        <span style="display: block; font-size: 0.75rem; color: #888;">@stat.Movie.Genre · @stat.Movie.Year</span>
                                    </div>
                                </td>
                                <td style="padding: 12px 15px; text-align: right; color: #46d369; font-weight: 700;">@stat.WatchCount.ToString("N0")</td>
                            </tr>
                            movieRank++;
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div style="color: #888; text-align: center; padding: 40px; font-style: italic;">
                    Chưa có lịch sử xem phim.
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.min.js"></script>
<script>
(function () {
    const PALETTE = ['#e50914','#3b82f6','#f59e0b','#10b981','#8b5cf6','#ec4899'];
    const gridOpts = {
        scales: {
            x: { grid: { color: 'rgba(255,255,255,.06)' }, ticks: { color: '#999', font: { size: 11 } } },
            y: { grid: { color: 'rgba(255,255,255,.06)' }, ticks: { color: '#999', font: { size: 11 } } }
        }
    };

    // ── Revenue + Orders dual-axis line chart ──
    new Chart(document.getElementById('revenueLineChart'), {
        type: 'line',
        data: {
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyLabels)),
            datasets: [
                {
                    label: 'Doanh thu (₫)',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyRevenue)),
                    borderColor: '#e50914',
                    backgroundColor: 'rgba(229,9,20,.12)',
                    borderWidth: 2.5,
                    fill: true,
                    tension: 0.4,
                    yAxisID: 'y',
                    pointBackgroundColor: '#e50914',
                },
                {
                    label: 'Đơn hàng',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyOrders)),
                    borderColor: '#3b82f6',
                    backgroundColor: 'rgba(59,130,246,.1)',
                    borderWidth: 2,
                    fill: false,
                    tension: 0.4,
                    yAxisID: 'y1',
                    pointBackgroundColor: '#3b82f6',
                    borderDash: [5,3],
                }
            ]
        },
        options: {
            responsive: true,
            interaction: { mode: 'index', intersect: false },
            plugins: { legend: { display: false }, tooltip: {
                callbacks: {
                    label: ctx => ctx.dataset.label === 'Doanh thu (₫)'
                        ? ctx.parsed.y.toLocaleString('vi-VN') + ' ₫'
                        : ctx.parsed.y + ' đơn'
                }
            }},
            scales: {
                x:  { grid: { color: 'rgba(255,255,255,.06)' }, ticks: { color: '#999' } },
                y:  { grid: { color: 'rgba(255,255,255,.06)' }, ticks: { color: '#e50914', callback: v => (v/1000)+'K ₫' }, position: 'left' },
                y1: { grid: { drawOnChartArea: false }, ticks: { color: '#3b82f6' }, position: 'right' }
            }
        }
    });

    // ── Plan doughnut ──
    new Chart(document.getElementById('planChart'), {
        type: 'doughnut',
        data: {
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PlanLabels)),
            datasets: [{
                data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PlanCounts)),
                backgroundColor: PALETTE,
                borderColor: '#1a1a2e',
                borderWidth: 3,
                hoverOffset: 10
            }]
        },
        options: {
            cutout: '65%',
            plugins: { legend: { display: false } },
            responsive: true
        }
    });

    // ── Payment method horizontal bar ──
    new Chart(document.getElementById('paymentChart'), {
        type: 'bar',
        data: {
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PaymentLabels)),
            datasets: [{
                data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PaymentCounts)),
                backgroundColor: PALETTE.map(c => c + 'cc'),
                borderRadius: 6,
                borderSkipped: false,
            }]
        },
        options: {
            indexAxis: 'y',
            responsive: true,
            plugins: { legend: { display: false } },
            scales: {
                x: { grid: { color: 'rgba(255,255,255,.06)' }, ticks: { color: '#999' } },
                y: { grid: { color: 'rgba(255,255,255,.06)' }, ticks: { color: '#ccc' } }
            }
        }
    });

    // ── Sub trend bar ──
    new Chart(document.getElementById('subTrendChart'), {
        type: 'bar',
        data: {
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyLabels)),
            datasets: [{
                label: 'Đăng ký mới',
                data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyNewSubs)),
                backgroundColor: 'rgba(245,158,11,.8)',
                borderRadius: 6,
                borderSkipped: false,
            }]
        },
        options: {
            responsive: true,
            plugins: { legend: { display: false } },
            ...gridOpts
        }
    });

    // inject legend dot colors for plan chart
    document.querySelectorAll('.legend-swatch').forEach((el, i) => {
        el.style.backgroundColor = PALETTE[i] ?? '#999';
    });
})();
</script>
}
