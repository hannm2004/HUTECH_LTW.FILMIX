@model Category
@{
    ViewData["Title"] = "Thêm Danh Mục Mới";
}

<div class="page-header">
    <h1>Thêm <span>Danh Mục Mới</span></h1>
</div>

<div class="form-card">
    <form asp-area="Admin" asp-controller="Category" asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div class="form-row">
            <label asp-for="Name">Tên Danh Mục</label>
            <input asp-for="Name" class="form-control" placeholder="Nhập tên danh mục..." />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-submit">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V7l-4-4zm-5 16c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm3-10H5V5h10v4z"/></svg>
                Thêm Danh Mục
            </button>
            <a asp-area="Admin" asp-controller="Category" asp-action="Index" class="btn-cancel">Hủy</a>
        </div>
    </form>
</div>
